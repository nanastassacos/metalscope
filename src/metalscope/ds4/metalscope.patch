+}
+
+/* metalscope: scope lookup off leaves the Engram add out (both layers, every row;
+ * its rows are still read). A scoped request runs the batched sweep
+ * (ds41_scope_sweep_begin), never its unscoped per-row fallbacks. */
+static bool ds41_engram_on(const ds41_gpu_graph *g) {
+    return !(g->scope && g->scope->lookup_off);
 }
 
