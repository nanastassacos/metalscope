+/* metalscope: the scope options' residual sums and logit ids; a body's "scope" and a completion's token-id prompt,
+ * both only under --scope-dir; a prompt of ids never reuses by text. */
+static void test_metalscope_scope_options_and_token_prompt(void) {
+    request r;
+    request_init(&r, REQ_COMPLETION, 1);
+    const char *opts = "{\"trace\":\"/t.bin\",\"lens\":[3, 7],\"rsum\":{\"sink\":4},\"logit_ids\":[5,0,9]}";
+    TEST_ASSERT(parse_scope_options(&opts, &r.scope) && r.scope.active);
+    TEST_ASSERT(r.scope.n_lens == 2 && r.scope.lens[1] == 7);
+    TEST_ASSERT(r.scope.rsum && r.scope.rsum_sink == 4);
+    TEST_ASSERT(r.scope.n_logit_ids == 3 && r.scope.logit_ids[0] == 5 && r.scope.logit_ids[2] == 9);
+    request_free(&r);
+    request_init(&r, REQ_COMPLETION, 1);
+    const char *none = "{\"trace\":\"/t.bin\"}";
+    TEST_ASSERT(parse_scope_options(&none, &r.scope) && !r.scope.rsum && r.scope.n_logit_ids == 0 && !r.scope.fresh);
+    TEST_ASSERT(r.scope.next_lp == 0 && !r.scope.lookup_off);     /* the lookup is on unless a request says not */
+    request_free(&r);
+    request_init(&r, REQ_COMPLETION, 1);
+    const char *fresh = "{\"trace\":\"/t.bin\",\"fresh\":true,\"next_lp\":12,\"lookup\":false}";
+    TEST_ASSERT(parse_scope_options(&fresh, &r.scope) && r.scope.active && r.scope.fresh);
+    TEST_ASSERT(r.scope.next_lp == 12 && r.scope.lookup_off);
+    request_free(&r);
+    request_init(&r, REQ_COMPLETION, 1);
+    const char *neg = "{\"trace\":\"/t.bin\",\"next_lp\":-1}";
+    TEST_ASSERT(parse_scope_options(&neg, &r.scope) && r.scope.next_lp == 0);
+    request_free(&r);
+
+    /* a session no scoped request steered: a request without a scope keeps it, and it may reach the disk cache */
+    int live_tok[3] = {5, 6, 7};
+    ds4_session *plain = ds4_session_new_test_checkpoint(live_tok, 3);
+    TEST_ASSERT(!ds4_session_scope_none(plain) && ds4_session_checkpoint_valid(plain));
+    TEST_ASSERT(!ds4_session_scope_private(plain) && !ds4_session_scope_active(plain));
+    ds4_tokens same = {0};
+    for (int i = 0; i < 3; i++) ds4_tokens_push(&same, live_tok[i]);
+    ds4_session_scope_prompt(plain, &same);     /* no scope: nothing happens */
+    TEST_ASSERT(ds4_session_checkpoint_valid(plain));
+    ds4_tokens_free(&same);
+    ds4_session_free_test_checkpoint(plain);
+
+    /* without --scope-dir ds4-server is as it was: "scope" is a key it does not know (even one that would not
+     * parse), and a prompt of numbers is the empty prompt */
+    char *text = NULL, err[160] = "";
+    ds4_tokens ids = {0};
+    const char *body = "{\"prompt\":\"hi\",\"scope\":{\"trace\":\"/t.bin\",\"lens\":[3]},\"max_tokens\":4}";
+    const char *bad_scope = "{\"scope\":{\"lens\":\"all\"},\"prompt\":\"hi\"}";
+    const char *numbers = "[151644, 0, 17]";
+    TEST_ASSERT(scope_dir == NULL);
+    request_init(&r, REQ_COMPLETION, 1);
+    TEST_ASSERT(scope_request_parse(body, &r, err, sizeof(err)) && !r.scope.active && !r.scope.trace);
+    TEST_ASSERT(scope_request_parse(bad_scope, &r, err, sizeof(err)) && !r.scope.active);
+    request_free(&r);
+    TEST_ASSERT(parse_prompt(&numbers, &text, &ids) && text && !text[0] && ids.len == 0);
+    free(text);
+    text = NULL;
+
+    /* with it: the object is read wherever it sits in the body, and one that does not parse refuses the request */
+    TEST_ASSERT(scope_dir_set("/tmp"));
+    request_init(&r, REQ_COMPLETION, 1);
+    TEST_ASSERT(scope_request_parse(body, &r, err, sizeof(err)) && r.scope.active && r.scope.n_lens == 1);
+    TEST_ASSERT(!scope_request_parse(bad_scope, &r, err, sizeof(err)) && !strcmp(err, "invalid JSON request"));
+    TEST_ASSERT(r.scope.trace == NULL);         /* freed with the request */
+    /* a body that names no scope is served as its parser read it, strict JSON or not */
+    request_init(&r, REQ_COMPLETION, 1);
+    TEST_ASSERT(scope_request_parse("{\"prompt\":\"hi\",\"stop\":[\"a\",]}", &r, err, sizeof(err)) && !r.scope.active);
+    TEST_ASSERT(!scope_request_parse("{\"stop\":[\"a\",],\"scope\":{\"trace\":\"/t.bin\"}}", &r, err, sizeof(err)));
+    /* a key cut short by the body's end stops the walk there: nothing past the terminator is read (the byte
+     * after it would otherwise be taken for more of the object) */
+    const char cut[] = "{\"\\\0,\"scope\":{\"trace\":\"/t.bin\"}}";
+    const char *walk = cut;
+    char *wkey = NULL;
+    bool wok = true;
+    TEST_ASSERT(!scope_json_key(&walk, true, &wkey, &wok) && !wok && wkey == NULL && walk <= cut + 4);
+    request_init(&r, REQ_COMPLETION, 1);
+    TEST_ASSERT(scope_request_parse(cut, &r, err, sizeof(err)) && !r.scope.active);    /* no "scope" before the end */
+    request_free(&r);
+    const char *prompt = "[151644, 0, 17]";
+    TEST_ASSERT(parse_prompt(&prompt, &text, &ids) && text == NULL);
+    TEST_ASSERT(ids.len == 3 && ids.v[0] == 151644 && ids.v[1] == 0 && ids.v[2] == 17);
+    const char *negative = "[3, -1]";
+    TEST_ASSERT(!parse_prompt(&negative, &text, &ids));
+    /* digits only: json_int (strtod) would take each of these for some integer */
+    static const char *not_ids[] = {"[1.7]", "[1e3]", "[1, NaN]", "[3, +4]", "[0x10]", "[2, Infinity]"};
+    for (size_t i = 0; i < sizeof(not_ids) / sizeof(not_ids[0]); i++) {
+        const char *bad = not_ids[i];
+        TEST_ASSERT(!parse_prompt(&bad, &text, &ids));
+    }
+    const char *spaced = "[ 4 ,5 ]";
+    TEST_ASSERT(parse_prompt(&spaced, &text, &ids) && ids.len == 2 && ids.v[0] == 4 && ids.v[1] == 5);
+    const char *words = "[\"hello\", \"ignored\"]";
+    TEST_ASSERT(parse_prompt(&words, &text, &ids) && text && !strcmp(text, "hello"));
+    free(text);
+    ds4_tokens_free(&ids);
+    free(scope_dir);
+    scope_dir = NULL;
+
+    /* the text-bound tier of test_slot_probe_and_routing_scores, refused to a prompt of ids */
+    server s = {0};
+    int stale_tok[3] = {5, 6, 7};
+    server_slot slot = {0};
+    slot.session = ds4_session_new_test_checkpoint(stale_tok, 3);
+    slot.live_text = (char *)"hello world";
+    slot.live_text_len = 11;
+    slot.live_text_pos = 3;
+    request_init(&r, REQ_COMPLETION, 1);
+    ds4_tokens_push(&r.prompt, 5);
+    ds4_tokens_push(&r.prompt, 6);
+    ds4_tokens_push(&r.prompt, 999);
+    r.prompt_text = xstrdup("hello world again");
+    TEST_ASSERT(slot_probe_reuse_locked(&s, &slot, &r).kind == REUSE_MEMORY_TEXT);
+    r.prompt_exact = true;
+    TEST_ASSERT(slot_probe_reuse_locked(&s, &slot, &r).kind == REUSE_NONE);
+    request_free(&r);
+    ds4_session_free_test_checkpoint(slot.session);
+}
