+/* metalscope: a request's scope files only inside the scope directory, as
+ * resolved: "..", a symlink out, a dangling symlink, a sibling sharing the
+ * prefix, a relative path, the directory itself. */
+static void test_metalscope_scope_dir(void) {
+    char base[] = "/tmp/ds4-scope-test-XXXXXX";
+    TEST_ASSERT(mkdtemp(base) != NULL);
+    char dir[PATH_MAX], other[PATH_MAX], p[PATH_MAX], q[PATH_MAX], out[PATH_MAX];
+    snprintf(dir, sizeof(dir), "%s/ds4", base);
+    snprintf(other, sizeof(other), "%s/ds4-other", base);
+    TEST_ASSERT(mkdir(dir, 0700) == 0 && mkdir(other, 0700) == 0);
+    TEST_ASSERT(scope_dir_set(dir));
+    char rdir[PATH_MAX];
+    TEST_ASSERT(realpath(dir, rdir) != NULL && !strcmp(scope_dir, rdir));   /* /tmp is /private/tmp on macOS */
+    snprintf(p, sizeof(p), "%s/runs", dir);
+    TEST_ASSERT(mkdir(p, 0700) == 0);
+
+    snprintf(p, sizeof(p), "%s/runs/r1.bin", dir);                 /* a new file in a subdirectory */
+    snprintf(q, sizeof(q), "%s/runs/r1.bin", rdir);
+    TEST_ASSERT(scope_path_inside(scope_dir, p, out, sizeof(out)) && !strcmp(out, q));
+    FILE *fp = fopen(p, "wb");                                      /* an existing one */
+    TEST_ASSERT(fp != NULL);
+    if (fp) fclose(fp);
+    TEST_ASSERT(scope_path_inside(scope_dir, p, out, sizeof(out)) && !strcmp(out, q));
+    snprintf(p, sizeof(p), "%s/runs/../runs/r1.bin", dir);
+    TEST_ASSERT(scope_path_inside(scope_dir, p, out, sizeof(out)) && !strcmp(out, q));
+
+    snprintf(p, sizeof(p), "%s/../ds4-other/x.bin", dir);           /* ".." out to a sibling with the prefix */
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    snprintf(p, sizeof(p), "%s/x.bin", other);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    snprintf(p, sizeof(p), "%s/../x.bin", dir);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    TEST_ASSERT(!scope_path_inside(scope_dir, dir, out, sizeof(out)));             /* the directory itself */
+    snprintf(p, sizeof(p), "%s/", dir);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    snprintf(p, sizeof(p), "%s/.", dir);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    TEST_ASSERT(!scope_path_inside(scope_dir, "runs/r1.bin", out, sizeof(out)));   /* relative */
+    TEST_ASSERT(!scope_path_inside(scope_dir, "", out, sizeof(out)));
+    snprintf(p, sizeof(p), "%s/missing/x.bin", dir);                /* no such directory */
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+
+    snprintf(p, sizeof(p), "%s/out", dir);                          /* a symlink inside to a directory outside */
+    TEST_ASSERT(symlink(other, p) == 0);
+    snprintf(p, sizeof(p), "%s/out/x.bin", dir);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    snprintf(q, sizeof(q), "%s/victim", other);                      /* a symlink to a file outside */
+    fp = fopen(q, "wb");
+    if (fp) fclose(fp);
+    snprintf(p, sizeof(p), "%s/link.bin", dir);
+    TEST_ASSERT(symlink(q, p) == 0);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+    snprintf(q, sizeof(q), "%s/not-yet", other);                     /* a dangling one */
+    snprintf(p, sizeof(p), "%s/dangling.bin", dir);
+    TEST_ASSERT(symlink(q, p) == 0);
+    TEST_ASSERT(!scope_path_inside(scope_dir, p, out, sizeof(out)));
+
+    /* the request's paths: replaced by their resolved paths, or refused as a whole */
+    request_scope o = {0};
+    snprintf(p, sizeof(p), "%s/runs/r2.bin", dir);
+    o.trace = xstrdup(p);
+    snprintf(p, sizeof(p), "%s/runs/../runs/r2.steer", dir);
+    o.steer = xstrdup(p);
+    char err[256] = "";
+    TEST_ASSERT(scope_request_paths(&o, scope_dir, err, sizeof(err)));
+    snprintf(q, sizeof(q), "%s/runs/r2.steer", rdir);
+    TEST_ASSERT(o.steer && !strcmp(o.steer, q));
+    snprintf(p, sizeof(p), "%s/j.bin", other);
+    o.jlens = xstrdup(p);
+    TEST_ASSERT(!scope_request_paths(&o, scope_dir, err, sizeof(err)) && strstr(err, "jlens"));
+    request_scope_free(&o);
+
+    /* the trace is a file of its own: a second open of the same name, an existing file, a symlink (dangling
+     * or not) and a FIFO are refused, without truncating, following or blocking (resolved paths, as the server
+     * hands over: /tmp is a symlink on macOS) */
+    snprintf(p, sizeof(p), "%s/runs/t.bin", rdir);
+    fp = ds4_scope_trace_create(p);
+    TEST_ASSERT(fp != NULL && fputs("x", fp) >= 0);
+    if (fp) fclose(fp);
+    TEST_ASSERT(ds4_scope_trace_create(p) == NULL);
+    struct stat st;
+    TEST_ASSERT(stat(p, &st) == 0 && st.st_size == 1);
+    snprintf(p, sizeof(p), "%s/runs/r1.bin", rdir);
+    TEST_ASSERT(ds4_scope_trace_create(p) == NULL);
+    snprintf(p, sizeof(p), "%s/link.bin", rdir);
+    TEST_ASSERT(ds4_scope_trace_create(p) == NULL);
+    snprintf(p, sizeof(p), "%s/dangling.bin", rdir);
+    snprintf(q, sizeof(q), "%s/not-yet", other);
+    TEST_ASSERT(ds4_scope_trace_create(p) == NULL && access(q, F_OK) != 0);
+    snprintf(p, sizeof(p), "%s/runs/f.fifo", rdir);
+    TEST_ASSERT(mkfifo(p, 0600) == 0 && ds4_scope_trace_create(p) == NULL);
+
+    free(scope_dir);
+    scope_dir = NULL;
+    static const char *made[] = {
+        "ds4/runs/r1.bin", "ds4/runs/t.bin", "ds4/runs/f.fifo", "ds4/runs", "ds4/out", "ds4/link.bin",
+        "ds4/dangling.bin", "ds4",
+        "ds4-other/victim", "ds4-other",
+    };
+    for (size_t i = 0; i < sizeof(made) / sizeof(made[0]); i++) {
+        snprintf(p, sizeof(p), "%s/%s", base, made[i]);
+        TEST_ASSERT(remove(p) == 0);
+    }
+    TEST_ASSERT(rmdir(base) == 0);
+}
