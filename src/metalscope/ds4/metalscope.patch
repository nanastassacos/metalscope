+#if defined(__APPLE__)
+/* metalscope's residual sums against a CPU reference: rows from row0 of a
+ * width-wide f32 tensor added into an output slot that already holds values,
+ * nothing else written; widths that are and are not multiples of 64, row
+ * counts that are and are not multiples of the 4 lanes. */
+static void test_metal_scope_rows_accum(void) {
+    static const struct { uint32_t width, row0, rows, slot; } cases[] = {
+        { 20480, 3, 2050, 2 },      /* V4.1's 4 x 5120 streams, a prefill chunk */
+        { 10240, 0, 1, 0 },         /* Qwen3.8's 4 x 2560, one decode row */
+        { 100, 5, 7, 1 },
+    };
+    const uint32_t n_slots = 3;
+    for (size_t c = 0; c < sizeof(cases) / sizeof(cases[0]); c++) {
+        const uint32_t W = cases[c].width, row0 = cases[c].row0, rows = cases[c].rows, slot = cases[c].slot;
+        const uint64_t x_count = (uint64_t)(row0 + rows + 2u) * W, out_count = (uint64_t)n_slots * W;
+        ds4_gpu_tensor *x = ds4_gpu_tensor_alloc(x_count * sizeof(float));
+        ds4_gpu_tensor *out = ds4_gpu_tensor_alloc(out_count * sizeof(float));
+        float *x_host = malloc((size_t)x_count * sizeof(float));
+        float *out_host = malloc((size_t)out_count * sizeof(float));
+        TEST_ASSERT(x && out && x_host && out_host);
+        if (x && out && x_host && out_host) {
+            uint32_t seed = 12345u + (uint32_t)c;
+            for (uint64_t i = 0; i < x_count; i++) {
+                seed = seed * 1664525u + 1013904223u;
+                x_host[i] = (float)((int32_t)(seed >> 8) % 20001 - 10000) * 1e-3f;
+            }
+            for (uint64_t i = 0; i < out_count; i++) out_host[i] = (float)(i % 7u) - 3.0f;
+            TEST_ASSERT(ds4_gpu_tensor_write(x, 0, x_host, x_count * sizeof(float)) != 0);
+            TEST_ASSERT(ds4_gpu_tensor_write(out, 0, out_host, out_count * sizeof(float)) != 0);
+            TEST_ASSERT(ds4_gpu_scope_rows_accum_tensor(x, W, row0, rows, out, slot * W) != 0);
+            float *got = malloc((size_t)out_count * sizeof(float));
+            TEST_ASSERT(got && ds4_gpu_tensor_read(out, 0, got, out_count * sizeof(float)) != 0);
+            uint32_t bad = 0;
+            double worst = 0.0;
+            for (uint32_t s = 0; got && s < n_slots; s++) {
+                for (uint32_t i = 0; i < W; i++) {
+                    const uint64_t at = (uint64_t)s * W + i;
+                    if (s != slot) {
+                        bad += got[at] != out_host[at];
+                        continue;
+                    }
+                    double ref = out_host[at], mag = fabs(ref);
+                    for (uint32_t r = 0; r < rows; r++) {
+                        const double v = x_host[(uint64_t)(row0 + r) * W + i];
+                        ref += v;
+                        mag += fabs(v);
+                    }
+                    const double e = fabs((double)got[at] - ref) / (mag + 1e-6);
+                    if (e > worst) worst = e;
+                    bad += e > 1e-5;
+                }
+            }
+            if (bad) fprintf(stderr, "scope rows accum width %u rows %u: %u bad, worst rel err %.2e\n", W, rows, bad, worst);
+            TEST_ASSERT(bad == 0);
+            free(got);
+        }
+        free(x_host);
+        free(out_host);
+        ds4_gpu_tensor_free(x);
+        ds4_gpu_tensor_free(out);
+    }
+}
