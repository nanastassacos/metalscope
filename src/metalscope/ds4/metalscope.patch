diff --git a/ds4_server_scope.inc b/ds4_server_scope.inc
new file mode 100644
index 0000000..58ca000
--- /dev/null
+++ b/ds4_server_scope.inc
@@ -0,0 +1,265 @@
+/* metalscope's request side, included by ds4_server.c before its request
+ * type: the body's "scope" object and a completion's prompt of token ids. The
+ * job side (capture around a request, the tokenize endpoint) is
+ * ds4_server_scope_job.inc. */
+
+/* The body's "scope" object, sent by metalscope's ds4 proxy:
+ *   "scope": {"trace": "/abs/file", "lens": [layer, ...], "topk": 10,
+ *             "steer": "/abs/file", "steer_decode_only": false,
+ *             "jlens": "/abs/file",
+ *             "rsum": {"sink": 4}, "logit_ids": [id, ...], "fresh": false,
+ *             "next_lp": 0, "lookup": true}
+ * trace: write the request's capture there; steer: this steering
+ * file (ds4_scope_session.inc, scope_load_steering); jlens: a J-lens to read beside the
+ * logit lens (scope_load_jlens); rsum: every layer's prompt rows from position sink on summed
+ * (RSUM); logit_ids: the output's log-probability at these ids (LIDS, at most
+ * DS4_SCOPE_MAX_IDS); fresh: read the whole prompt (no reuse of the session's rows);
+ * next_lp: from that prompt position on, each prompt token's log-probability
+ * (NXLP) and the row's top 10 (NXTK); lookup false: the n-gram lookup (Qwen3.8's
+ * PLE, V4.1's Engram) adds nothing (a measurement).  A scoped request reuses the live session's
+ * rows as any request does when they were computed under its steering
+ * (ds4_session_scope_begin), never the disk KV cache.  The three files must lie
+ * in the directory --scope-dir names (scope_request_paths).  Without
+ * --scope-dir the object is not read (scope_request_parse): ds4-server serves
+ * the request as it does any other. */
+typedef struct {
+    bool active;
+    char *trace;
+    char *steer;
+    char *jlens;
+    int topk;
+    int n_lens;
+    int lens[DS4_SCOPE_MAX_LENS];
+    bool steer_decode_only;
+    bool rsum;
+    int rsum_sink;
+    int n_logit_ids;
+    int logit_ids[DS4_SCOPE_MAX_IDS];
+    bool fresh;
+    int next_lp;
+    bool lookup_off;
+} request_scope;
+
+/* ds4_server_scope_job.inc: the prompt a scoped request syncs, once generate_job_inner knows its reuse. */
+struct server_slot;
+static void scope_job_prompt(server *s, struct server_slot *slot, const ds4_tokens *prompt);
+
+static void request_scope_free(request_scope *o) {
+    free(o->trace);
+    free(o->steer);
+    free(o->jlens);
+}
+
+/* --scope-dir DIR (metalscope passes it): the one directory a request's scope
+ * files may be in, resolved as ds4-server starts (before --chdir). Unset:
+ * ds4-server reads no "scope" object, takes a completion's prompt of numbers as
+ * it always has, and has no tokenize endpoint. */
+static char *scope_dir;
+
+static bool scope_dir_set(const char *dir) {
+    char res[PATH_MAX];
+    struct stat st;
+    if (!realpath(dir, res) || stat(res, &st) != 0 || !S_ISDIR(st.st_mode)) return false;
+    free(scope_dir);
+    scope_dir = xstrdup(res);
+    return true;
+}
+
+/* path as opening it would reach it (symlinks and ".." resolved): the file
+ * itself when it exists, else its directory's resolved path and its name.
+ * True, with that path in out, only when path is absolute and lands strictly
+ * inside dir (a resolved directory, compared up to a separator so "/a/ds4"
+ * never admits "/a/ds4-other"). A name that exists but does not resolve (a
+ * dangling symlink) is refused. */
+static bool scope_path_inside(const char *dir, const char *path, char *out, size_t outlen) {
+    if (!dir || !dir[0] || !path || path[0] != '/') return false;
+    char res[PATH_MAX];
+    if (!realpath(path, res)) {
+        struct stat st;
+        if (errno != ENOENT || lstat(path, &st) == 0) return false;
+        const char *slash = strrchr(path, '/');
+        const char *name = slash + 1;
+        if (!name[0] || !strcmp(name, ".") || !strcmp(name, "..")) return false;
+        char parent[PATH_MAX], pres[PATH_MAX];
+        const size_t plen = slash == path ? 1 : (size_t)(slash - path);
+        if (plen >= sizeof(parent)) return false;
+        memcpy(parent, path, plen);
+        parent[plen] = '\0';
+        if (!realpath(parent, pres)) return false;
+        const int w = snprintf(res, sizeof(res), "%s/%s", strcmp(pres, "/") ? pres : "", name);
+        if (w < 0 || (size_t)w >= sizeof(res)) return false;
+    }
+    const size_t n = strlen(dir);
+    const size_t at = dir[n - 1] == '/' ? n : n + 1;        /* past the separator ("/" ends in one) */
+    if (strncmp(res, dir, n) != 0 || (at > n && res[n] != '/') || !res[at]) return false;
+    if (strlen(res) >= outlen) return false;
+    memcpy(out, res, strlen(res) + 1);
+    return true;
+}
+
+/* Each file a scoped request names, checked against the scope directory and
+ * replaced by its resolved path (what is opened). False, with the error, when
+ * a file is outside it: nothing is opened. */
+static bool scope_request_paths(request_scope *o, const char *dir, char *err, size_t errlen) {
+    struct { const char *what; char **path; } files[] = {
+        {"trace", &o->trace}, {"steer", &o->steer}, {"jlens", &o->jlens},
+    };
+    for (size_t i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+        char *path = *files[i].path;
+        if (!path || !path[0]) continue;
+        char res[PATH_MAX];
+        if (!scope_path_inside(dir, path, res, sizeof(res))) {
+            snprintf(err, errlen, "scope: %s file %s is not in the scope directory %s", files[i].what, path, dir);
+            return false;
+        }
+        free(path);
+        *files[i].path = xstrdup(res);
+    }
+    return true;
+}
+
+/* Walks the keys of the JSON object at *p (first: at its '{'; then after each
+ * value): true with the key (the caller frees it) and *p at its value.  False
+ * once past the closing '}', or at a syntax error (*ok false), where the walk
+ * ends: a string cut short leaves *p at the terminator. */
+static bool scope_json_key(const char **p, bool first, char **key, bool *ok) {
+    *key = NULL;
+    json_ws(p);
+    if (first) {
+        if (**p != '{') return *ok = false;
+        (*p)++;
+    } else if (**p == ',') {
+        (*p)++;
+    }
+    json_ws(p);
+    if (**p == '}') {
+        (*p)++;
+        return false;
+    }
+    *ok = json_string(p, key);
+    if (*ok) {
+        json_ws(p);
+        *ok = **p == ':';
+    }
+    if (!*ok) {
+        free(*key);
+        return false;
+    }
+    (*p)++;
+    json_ws(p);
+    return true;
+}
+
+static bool parse_scope_ints(const char **p, int *out, int cap, int *n) {
+    *n = 0;
+    if (**p != '[') return false;
+    (*p)++;
+    json_ws(p);
+    bool ok = true;
+    while (ok && **p && **p != ']') {
+        int v = 0;
+        ok = json_int(p, &v) && *n < cap;
+        if (ok) out[(*n)++] = v;
+        json_ws(p);
+        if (**p == ',') (*p)++;
+        json_ws(p);
+    }
+    if (!ok || **p != ']') return false;
+    (*p)++;
+    return true;
+}
+
+static bool parse_scope_rsum(const char **p, request_scope *o) {
+    bool ok = true;
+    char *key;
+    for (bool first = true; ok && scope_json_key(p, first, &key, &ok); first = false) {
+        ok = !strcmp(key, "sink") ? json_int(p, &o->rsum_sink) : json_skip_value(p);
+        free(key);
+    }
+    o->rsum = ok;
+    return ok;
+}
+
+static bool parse_scope_options(const char **p, request_scope *o) {
+    json_ws(p);
+    if (**p != '{') return json_skip_value(p);
+    bool ok = true;
+    char *key;
+    for (bool first = true; ok && scope_json_key(p, first, &key, &ok); first = false) {
+        if (!strcmp(key, "trace")) {
+            free(o->trace);
+            o->trace = NULL;
+            ok = json_string(p, &o->trace);
+        } else if (!strcmp(key, "steer")) {
+            free(o->steer);
+            o->steer = NULL;
+            ok = json_string(p, &o->steer);
+        } else if (!strcmp(key, "jlens")) {
+            free(o->jlens);
+            o->jlens = NULL;
+            ok = json_string(p, &o->jlens);
+        } else if (!strcmp(key, "topk")) {
+            ok = json_int(p, &o->topk);
+        } else if (!strcmp(key, "steer_decode_only")) {
+            ok = json_bool(p, &o->steer_decode_only);
+        } else if (!strcmp(key, "fresh")) {
+            ok = json_bool(p, &o->fresh);
+        } else if (!strcmp(key, "next_lp")) {
+            ok = json_int(p, &o->next_lp);    /* a negative one reads as 0: off */
+        } else if (!strcmp(key, "lookup")) {
+            bool on = true;
+            ok = json_bool(p, &on);
+            o->lookup_off = !on;
+        } else if (!strcmp(key, "lens")) {
+            ok = parse_scope_ints(p, o->lens, (int)DS4_SCOPE_MAX_LENS, &o->n_lens);
+        } else if (!strcmp(key, "logit_ids")) {
+            ok = parse_scope_ints(p, o->logit_ids, (int)DS4_SCOPE_MAX_IDS, &o->n_logit_ids);
+        } else if (!strcmp(key, "rsum")) {
+            ok = parse_scope_rsum(p, o);
+        } else {
+            ok = json_skip_value(p);
+        }
+        free(key);
+    }
+    if (!ok) return false;
+    o->active = (o->trace && o->trace[0]) || (o->steer && o->steer[0]);
+    return true;
+}
+
+/* A completion's prompt as an array of token ids, after its '[' (parse_prompt,
+ * under --scope-dir): fed as given, with no chat template. */
+static bool parse_prompt_ids(const char **p, ds4_tokens *ids) {
+    ids->len = 0;
+    while (**p && **p != ']') {
+        /* digits only: json_int reads with strtod, which takes 1.7, 1e3, +4, 0x10 and NaN */
+        const char *end = *p;
+        while (*end >= '0' && *end <= '9') end++;
+        int v = 0;
+        if (end == *p || !json_int(p, &v) || *p != end) return false;
+        ds4_tokens_push(ids, v);
+        json_ws(p);
+        if (**p == ',') (*p)++;
+        json_ws(p);
+    }
+    if (**p != ']') return false;
+    (*p)++;
+    return true;
+}
+
+/* The ids are the prompt (their text only for the thinking state and the
+ * logs): moved into *prompt, or freed with the error when one is outside the
+ * vocabulary. */
+static bool scope_prompt_ids(ds4_engine *e, ds4_tokens *ids, ds4_tokens *prompt, char **prompt_text,
+                             char *err, size_t errlen) {
+    const int vocab = ds4_engine_vocab_size(e);
+    for (int i = 0; i < ids->len; i++) {
+        if (ids->v[i] >= vocab) {
+            snprintf(err, errlen, "prompt token id %d is outside the vocabulary (%d)", ids->v[i], vocab);
+            ds4_tokens_free(ids);
+            return false;
+        }
+    }
+    *prompt = *ids;
+    *prompt_text = ds4_kvstore_render_tokens_text(e, prompt, NULL);
+    return true;
+}
diff --git a/ds4_server_scope_job.inc b/ds4_server_scope_job.inc
new file mode 100644
index 0000000..d6ea59e
--- /dev/null
+++ b/ds4_server_scope_job.inc
@@ -0,0 +1,141 @@
+/* metalscope's job side, included by ds4_server.c before generate_job: the
+ * body's "scope" object, the capture and steering around one request, and the
+ * tokenize endpoint. */
+
+/* The "scope" object of a body its endpoint's parser has accepted (r; the
+ * parsers skip the key as any they do not know).  Read only under --scope-dir,
+ * and only from a body that names "scope": such a body must be strict JSON
+ * (its other values are skipped as JSON, where the parsers are more lenient);
+ * any other body is served as parsed.  False, with the error and r freed,
+ * when the body or the object does not parse. */
+static bool scope_request_parse(const char *body, request *r, char *err, size_t errlen) {
+    const char *p = body;
+    if (!scope_dir || !p || !strstr(p, "\"scope\"")) return true;
+    bool ok = true;
+    char *key;
+    for (bool first = true; ok && scope_json_key(&p, first, &key, &ok); first = false) {
+        ok = !strcmp(key, "scope") ? parse_scope_options(&p, &r->scope) : json_skip_value(&p);
+        free(key);
+    }
+    if (ok) return true;
+    snprintf(err, errlen, "invalid JSON request");
+    request_free(r);
+    return false;
+}
+
+/* Capture and/or steer this request (ds4_scope.h): the session keeps its rows
+ * when they were computed under the request's steering, else starts empty
+ * (ds4_session_scope_begin).  A request without a scope empties a session whose
+ * rows were steered.  The server's live-continuation state goes with an
+ * emptied session.  1: scoped, 0: not, -1: refused (answered 400): a file
+ * outside the scope directory is refused before anything is opened. */
+static int scope_job_begin(server *s, server_slot *slot, job *j) {
+    if (job_cancelled(j)) return 0;
+    if (!j->req.scope.active) {
+        if (!ds4_session_scope_private(slot->session)) return 0;    /* only this slot's job changes it */
+        pthread_mutex_lock(&s->inference_mu);
+        const bool emptied = ds4_session_scope_none(slot->session);
+        pthread_mutex_unlock(&s->inference_mu);
+        if (emptied) request_live_state_clear(s, slot);
+        return 0;
+    }
+    char err[256] = "";
+    if (!scope_request_paths(&j->req.scope, scope_dir, err, sizeof(err))) {
+        http_error(j->fd, s->enable_cors, 400, err);
+        return -1;
+    }
+    ds4_scope_cfg cfg = {
+        .trace_path = j->req.scope.trace,
+        .steer_path = j->req.scope.steer,
+        .topk = j->req.scope.topk,
+        .n_lens = j->req.scope.n_lens,
+        .lens_layers = j->req.scope.lens,
+        .steer_decode_only = j->req.scope.steer_decode_only,
+        .jlens_path = j->req.scope.jlens,
+        .rsum = j->req.scope.rsum,
+        .rsum_sink = j->req.scope.rsum_sink,
+        .n_logit_ids = j->req.scope.n_logit_ids,
+        .logit_ids = j->req.scope.logit_ids,
+        .fresh = j->req.scope.fresh,
+        .next_lp = j->req.scope.next_lp,
+        .lookup_off = j->req.scope.lookup_off,
+    };
+    pthread_mutex_lock(&s->inference_mu);
+    const int rc = ds4_session_scope_begin(slot->session, &cfg, err, sizeof(err));
+    if (rc == 0) ds4_session_scope_prompt(slot->session, &j->req.prompt);
+    const bool emptied = !ds4_session_checkpoint_valid(slot->session);
+    pthread_mutex_unlock(&s->inference_mu);
+    if (rc != 0) {
+        http_error(j->fd, s->enable_cors, 400, err);
+        return -1;
+    }
+    if (emptied) request_live_state_clear(s, slot);
+    return 1;
+}
+
+/* generate_job_inner has chosen what the request reuses: the tokens it syncs are the prompt the record holds (a
+ * reused live state can make them other than the request's own prompt). */
+static void scope_job_prompt(server *s, server_slot *slot, const ds4_tokens *prompt) {
+    if (!ds4_session_scope_active(slot->session)) return;
+    pthread_mutex_lock(&s->inference_mu);
+    ds4_session_scope_prompt(slot->session, prompt);
+    pthread_mutex_unlock(&s->inference_mu);
+}
+
+static void scope_job_end(server *s, server_slot *slot, job *j) {
+    pthread_mutex_lock(&s->inference_mu);
+    ds4_session_scope_end(slot->session, job_cancelled(j) ? "cancelled" : "done");
+    const bool emptied = !ds4_session_checkpoint_valid(slot->session);
+    pthread_mutex_unlock(&s->inference_mu);
+    if (emptied) request_live_state_clear(s, slot);
+}
+
+/* POST /v1/scope/tokenize (under --scope-dir) answers {"tokens": [...]}
+ * without a job.  {"text": "...", "specials": false} tokenises the text (specials: the
+ * chat markers in it are read as ds4 reads a rendered chat); any other body
+ * is a chat completion request, and the tokens are the prompt ds4 would
+ * serve it. */
+static void send_scope_tokens(server *s, int fd, const char *body) {
+    const char *p = body;
+    char *text = NULL;
+    bool specials = false, ok = true;
+    char *key;
+    for (bool first = true; ok && scope_json_key(&p, first, &key, &ok); first = false) {
+        if (!strcmp(key, "text")) {
+            free(text);
+            ok = json_string(&p, &text);
+        } else if (!strcmp(key, "specials")) {
+            ok = json_bool(&p, &specials);
+        } else {
+            ok = json_skip_value(&p);
+        }
+        free(key);
+    }
+    if (!ok) {
+        free(text);
+        http_error(fd, s->enable_cors, 400, "invalid JSON request");
+        return;
+    }
+    ds4_tokens tokens = {0};
+    if (text) {
+        if (specials) ds4_tokenize_rendered_chat(s->engine, text, &tokens);
+        else ds4_tokenize_text(s->engine, text, &tokens);
+        free(text);
+    } else {
+        request r;
+        char err[160];
+        if (!parse_chat_request(s->engine, s, body, s->default_tokens, s->ctx_size, &r, err, sizeof(err))) {
+            http_error(fd, s->enable_cors, 400, err);
+            return;
+        }
+        ds4_tokens_copy(&tokens, &r.prompt);
+        request_free(&r);
+    }
+    buf out = {0};
+    buf_puts(&out, "{\"tokens\":[");
+    for (int i = 0; i < tokens.len; i++) buf_printf(&out, i ? ",%d" : "%d", tokens.v[i]);
+    buf_puts(&out, "]}");
+    http_response(fd, s->enable_cors, 200, "application/json", out.ptr);
+    buf_free(&out);
+    ds4_tokens_free(&tokens);
+}
diff --git a/metal/scope.metal b/metal/scope.metal
new file mode 100644
index 0000000..1e99e06
--- /dev/null
+++ b/metal/scope.metal
@@ -0,0 +1,256 @@
+// metalscope capture and steering kernels (ds4_metal_scope.inc).
+
+// metalscope capture: sum of squares of each row (one threadgroup per row),
+// written at out[out_off + row], and the sum of squares of the row less the
+// same row of before (the row as it stood earlier), written at
+// wout[out_off + row]; then before takes the row.  The trace reads
+// per-stream residual norms and what each layer changed in each stream from
+// them without copying the residual rows to the host.
+struct ds4_metal_args_scope_rows_sumsq {
+    uint32_t width;
+    uint32_t rows;
+    uint32_t out_off;
+    uint32_t n_threads;
+};
+
+kernel void kernel_scope_rows_sumsq_f32(
+        constant ds4_metal_args_scope_rows_sumsq & args,
+        device const float *x,
+        device float *out,
+        device float *before,
+        device float *wout,
+        threadgroup float *scratch [[threadgroup(0)]],
+        uint row [[threadgroup_position_in_grid]],
+        uint tid [[thread_position_in_threadgroup]]) {
+    if (row >= args.rows || args.width == 0) return;
+    device const float *xr = x + (uint64_t)row * args.width;
+    device float *br = before + (uint64_t)row * args.width;
+    const uint nth = args.n_threads;
+    float sum = 0.0f, wsum = 0.0f;
+    for (uint i = tid; i < args.width; i += nth) {
+        const float v = xr[i];
+        const float d = v - br[i];
+        sum += v * v;
+        wsum += d * d;
+        br[i] = v;          // read and written by this thread only
+    }
+    scratch[tid] = sum;
+    scratch[nth + tid] = wsum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint step = nth >> 1; step > 0; step >>= 1) {
+        if (tid < step) {
+            scratch[tid] += scratch[tid + step];
+            scratch[nth + tid] += scratch[nth + tid + step];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (tid == 0) {
+        out[args.out_off + row] = scratch[0];
+        wout[args.out_off + row] = scratch[nth];
+    }
+}
+
+// metalscope capture: softmax statistics of each logit row (one threadgroup
+// per row): out[3 * (out_off + row) + {0, 1, 2}] = max z, sum exp(z - max),
+// sum exp(z - max) * z.  The host gets log-probabilities and the entropy from
+// them and only has to pick each row's top-k.
+kernel void kernel_scope_row_stats_f32(
+        constant ds4_metal_args_scope_rows_sumsq & args,
+        device const float *x,
+        device float *out,
+        threadgroup float *scratch [[threadgroup(0)]],
+        uint row [[threadgroup_position_in_grid]],
+        uint tid [[thread_position_in_threadgroup]]) {
+    if (row >= args.rows || args.width == 0) return;
+    device const float *xr = x + (uint64_t)row * args.width;
+    const uint nth = args.n_threads;
+    float m = -MAXFLOAT;
+    for (uint i = tid; i < args.width; i += nth) m = max(m, xr[i]);
+    scratch[tid] = m;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint step = nth >> 1; step > 0; step >>= 1) {
+        if (tid < step) scratch[tid] = max(scratch[tid], scratch[tid + step]);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    m = scratch[0];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float s = 0.0f, sz = 0.0f;
+    for (uint i = tid; i < args.width; i += nth) {
+        const float z = xr[i];
+        const float e = exp(z - m);
+        s += e;
+        sz += e * z;
+    }
+    scratch[tid] = s;
+    scratch[nth + tid] = sz;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint step = nth >> 1; step > 0; step >>= 1) {
+        if (tid < step) {
+            scratch[tid] += scratch[tid + step];
+            scratch[nth + tid] += scratch[nth + tid + step];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (tid == 0) {
+        device float *o = out + 3u * ((uint64_t)args.out_off + row);
+        o[0] = m;
+        o[1] = scratch[0];
+        o[2] = scratch[nth];
+    }
+}
+
+// metalscope steering: x[r][i] += v[layer][i] for every row r (the vector is
+// already scaled; width is the whole hyper-connection row, n_hc * n_embd).
+struct ds4_metal_args_scope_add_rows {
+    uint32_t width;
+    uint32_t rows;
+    uint32_t layer;
+    uint32_t pad;
+};
+
+kernel void kernel_scope_add_rows_f32(
+        constant ds4_metal_args_scope_add_rows & args,
+        device float *x,
+        device const float *v,
+        uint gid [[thread_position_in_grid]]) {
+    const uint64_t n = (uint64_t)args.width * args.rows;
+    if ((uint64_t)gid >= n) return;
+    x[gid] += v[(uint64_t)args.layer * args.width + gid % args.width];
+}
+
+// metalscope steering, removal: x[r] -= sum_j (x[r] . q[q_row0 + j]) q[q_row0 + j]
+// for every row r and the n_q orthonormal directions (the host bounds n_q and sizes the scratch) (whole rows, as
+// the add's vector).  One threadgroup per row: each thread sums its stride
+// of the dots in f32, the group adds them pairwise, then each thread
+// rewrites its own stride, so every dot is of the row as it was.
+struct ds4_metal_args_scope_remove_rows {
+    uint32_t width;
+    uint32_t rows;
+    uint32_t q_row0;
+    uint32_t n_q;
+    uint32_t n_threads;
+    uint32_t pad;
+};
+
+kernel void kernel_scope_remove_rows_f32(
+        constant ds4_metal_args_scope_remove_rows & args,
+        device float *x,
+        device const float *q,
+        threadgroup float *scratch [[threadgroup(0)]],
+        uint row [[threadgroup_position_in_grid]],
+        uint tid [[thread_position_in_threadgroup]]) {
+    if (row >= args.rows) return;
+    device float *xr = x + (uint64_t)row * args.width;
+    device const float *q0 = q + (uint64_t)args.q_row0 * args.width;
+    const uint nth = args.n_threads;
+    for (uint j = 0; j < args.n_q; j++) {
+        device const float *qj = q0 + (uint64_t)j * args.width;
+        float sum = 0.0f;
+        for (uint i = tid; i < args.width; i += nth) sum += xr[i] * qj[i];
+        scratch[j * nth + tid] = sum;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint step = nth >> 1; step > 0; step >>= 1) {
+        if (tid < step) {
+            for (uint j = 0; j < args.n_q; j++) scratch[j * nth + tid] += scratch[j * nth + tid + step];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    for (uint i = tid; i < args.width; i += nth) {
+        float d = 0.0f;
+        for (uint j = 0; j < args.n_q; j++) d += scratch[j * nth] * q0[(uint64_t)j * args.width + i];
+        xr[i] -= d;
+    }
+}
+
+// metalscope J-lens reads: for rows r < rows and outputs
+// j < n_out,
+//   out[out_off + r * out_stride + j] = sum_i x[r * x_stride + i] * w[(w_row0 + j) * width + i]
+// in f32 (w is f16).  One threadgroup per tile of 8 rows x 8 outputs,
+// its threads striding over i: each reads the tile's 8 weight rows and 8
+// input rows once, so a decode read of a [n_out, width] matrix reads it once.
+struct ds4_metal_args_scope_project {
+    uint32_t width;
+    uint32_t n_out;
+    uint32_t rows;
+    uint32_t x_stride;
+    uint32_t w_row0;
+    uint32_t out_off;
+    uint32_t out_stride;
+    uint32_t pad;
+};
+
+kernel void kernel_scope_project_f16(
+        constant ds4_metal_args_scope_project & args,
+        device const float *x,
+        device const half *w,
+        device float *out,
+        threadgroup float *scratch [[threadgroup(0)]],
+        uint3 tg [[threadgroup_position_in_grid]],
+        uint3 tpg [[threads_per_threadgroup]],
+        uint tid [[thread_index_in_threadgroup]],
+        uint sid [[simdgroup_index_in_threadgroup]],
+        uint lane [[thread_index_in_simdgroup]],
+        uint nsg [[simdgroups_per_threadgroup]]) {
+    const uint nth = tpg.x;
+    const uint j0 = tg.x * 8u, r0 = tg.y * 8u;
+    if (j0 >= args.n_out || r0 >= args.rows) return;
+    const uint nj = min(8u, args.n_out - j0), nr = min(8u, args.rows - r0);
+    float acc[8][8];
+    for (uint a = 0; a < 8u; a++) for (uint b = 0; b < 8u; b++) acc[a][b] = 0.0f;
+    for (uint i = tid; i < args.width; i += nth) {
+        float wv[8];
+        for (uint b = 0; b < 8u; b++)
+            wv[b] = b < nj ? (float)w[(uint64_t)(args.w_row0 + j0 + b) * args.width + i] : 0.0f;
+        for (uint a = 0; a < 8u; a++) {
+            const float xv = a < nr ? x[(uint64_t)(r0 + a) * args.x_stride + i] : 0.0f;
+            for (uint b = 0; b < 8u; b++) acc[a][b] += xv * wv[b];
+        }
+    }
+    for (uint a = 0; a < 8u; a++) {
+        for (uint b = 0; b < 8u; b++) {
+            const float s = simd_sum(acc[a][b]);
+            if (lane == 0) scratch[sid * 64u + a * 8u + b] = s;
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid < 64u) {
+        const uint a = tid / 8u, b = tid % 8u;
+        if (a < nr && b < nj) {
+            float s = 0.0f;
+            for (uint g = 0; g < nsg; g++) s += scratch[g * 64u + tid];
+            out[(uint64_t)args.out_off + (uint64_t)(r0 + a) * args.out_stride + j0 + b] = s;
+        }
+    }
+}
+
+// metalscope residual sums: for i < width,
+//   out[out_off + i] += sum over r < rows of x[(row0 + r) * width + i]
+// in f32.  One threadgroup per 64 columns, its 4 row lanes taking every 4th
+// row; the lanes are added in a fixed order, so a sum does not depend on
+// scheduling (the host calls it with 256 threads).
+struct ds4_metal_args_scope_rows_accum {
+    uint32_t width;
+    uint32_t row0;
+    uint32_t rows;
+    uint32_t out_off;
+};
+
+kernel void kernel_scope_rows_accum_f32(
+        constant ds4_metal_args_scope_rows_accum & args,
+        device const float *x,
+        device float *out,
+        threadgroup float *scratch [[threadgroup(0)]],
+        uint tg [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]]) {
+    const uint c = tid % 64u, lane = tid / 64u;
+    const uint i = tg * 64u + c;
+    float s = 0.0f;
+    if (i < args.width && lane < 4u) {
+        for (uint r = lane; r < args.rows; r += 4u) s += x[(uint64_t)(args.row0 + r) * args.width + i];
+    }
+    if (lane < 4u) scratch[lane * 64u + c] = s;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane == 0 && i < args.width)
+        out[(uint64_t)args.out_off + i] += (scratch[c] + scratch[64u + c]) + (scratch[128u + c] + scratch[192u + c]);
+}
