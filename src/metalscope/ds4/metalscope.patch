+/* metalscope capture and steering kernels, included by ds4_gpu.h (Metal
+ * only: ds4_metal_scope.inc; ds4.c calls them under __APPLE__). */
+#define DS4_SCOPE_MAX_REMOVE 8u     /* directions one removal projects out (the kernel's threadgroup scratch) */
+
+#ifdef __APPLE__
+/* out[out_off + r] = sum_i x[r][i]^2 and wout[out_off + r] = sum_i (x[r][i] - before[r][i])^2, i < width, then
+ * before[r] = x[r] (per stream: a residual's norms, and what changed in it since before). */
+int ds4_gpu_scope_rows_sumsq_tensor(
+        const ds4_gpu_tensor *x,
+        ds4_gpu_tensor       *out,
+        ds4_gpu_tensor       *before,
+        ds4_gpu_tensor       *wout,
+        uint32_t              width,
+        uint32_t              rows,
+        uint32_t              out_off);
+
+int ds4_gpu_scope_row_stats_tensor(
+        const ds4_gpu_tensor *x,
+        ds4_gpu_tensor       *out,
+        uint32_t              width,
+        uint32_t              rows,
+        uint32_t              out_off);
+
+int ds4_gpu_scope_add_rows_tensor(
+        ds4_gpu_tensor       *x,
+        const ds4_gpu_tensor *v,
+        uint32_t              layer,
+        uint32_t              width,
+        uint32_t              rows);
+
+/* x[r] -= sum_j (x[r] . q[q_row0 + j]) q[q_row0 + j], j < n_q <= DS4_SCOPE_MAX_REMOVE orthonormal rows
+ * of q, f32 sums. */
+int ds4_gpu_scope_remove_rows_tensor(
+        ds4_gpu_tensor       *x,
+        const ds4_gpu_tensor *q,
+        uint32_t              q_row0,
+        uint32_t              n_q,
+        uint32_t              width,
+        uint32_t              rows);
+
+/* out[out_off + r * out_stride + j] = x[r * x_stride ..] . w[(w_row0 + j) * width ..], f32 sums (w f16). */
+int ds4_gpu_scope_project_tensor(
+        const ds4_gpu_tensor *x,
+        uint32_t              x_stride,
+        const ds4_gpu_tensor *w,
+        uint32_t              w_row0,
+        uint32_t              width,
+        uint32_t              n_out,
+        uint32_t              rows,
+        ds4_gpu_tensor       *out,
+        uint32_t              out_off,
+        uint32_t              out_stride);
+
+/* out[out_off + i] += sum over r < rows of x[(row0 + r) * width + i], i < width, in f32 (residual sums). */
+int ds4_gpu_scope_rows_accum_tensor(
+        const ds4_gpu_tensor *x,
+        uint32_t              width,
+        uint32_t              row0,
+        uint32_t              rows,
+        ds4_gpu_tensor       *out,
+        uint32_t              out_off);
+#endif
+
+#endif
