+/* metalscope's stream norms and writes against a CPU reference in doubles, as
+ * scope_resid stages two layers: each stream row's sum of squares and the sum
+ * of squares of its change since before, at out_off of outputs that hold other
+ * values, nothing else written; before holds the rows afterwards, so the
+ * second layer's change is measured from the first's output. */
+static void test_metal_scope_rows_sumsq(void) {
+    static const struct { uint32_t width, rows, out_off; } cases[] = {
+        { 2560, 4, 8 },             /* Qwen3.8: one decode row, 4 streams of 2560 */
+        { 5120, 4 * 37, 4 },        /* V4.1's 5120-wide streams, a few prefill rows */
+        { 100, 3, 0 },
+    };
+    for (size_t c = 0; c < sizeof(cases) / sizeof(cases[0]); c++) {
+        const uint32_t W = cases[c].width, rows = cases[c].rows, off = cases[c].out_off, n_out = off + rows + 3u;
+        const uint64_t n = (uint64_t)rows * W;
+        ds4_gpu_tensor *x = ds4_gpu_tensor_alloc(n * sizeof(float)), *b = ds4_gpu_tensor_alloc(n * sizeof(float));
+        ds4_gpu_tensor *out = ds4_gpu_tensor_alloc((uint64_t)n_out * sizeof(float));
+        ds4_gpu_tensor *wout = ds4_gpu_tensor_alloc((uint64_t)n_out * sizeof(float));
+        float *xh[2] = {malloc((size_t)n * sizeof(float)), malloc((size_t)n * sizeof(float))};
+        float *bh = malloc((size_t)n * sizeof(float)), *got = malloc((size_t)n * sizeof(float));
+        float *init = malloc((size_t)n_out * sizeof(float)), *o = malloc((size_t)n_out * sizeof(float));
+        float *wo = malloc((size_t)n_out * sizeof(float));
+        const bool have = x && b && out && wout && xh[0] && xh[1] && bh && got && init && o && wo;
+        TEST_ASSERT(have);
+        if (have) {
+            uint32_t seed = 4242u + (uint32_t)c;
+            #define SCOPE_RAND() (seed = seed * 1664525u + 1013904223u, (float)((int32_t)(seed >> 8) % 20001 - 10000) * 1e-3f)
+            /* streams of elements up to 30; the first layer changes every element a little, the second a few a lot */
+            for (uint64_t i = 0; i < n; i++) bh[i] = 3.0f * SCOPE_RAND();
+            for (uint64_t i = 0; i < n; i++) xh[0][i] = bh[i] + 0.01f * SCOPE_RAND();
+            for (uint64_t i = 0; i < n; i++) xh[1][i] = xh[0][i] + (i % 7u ? 0.0f : 0.5f * SCOPE_RAND());
+            #undef SCOPE_RAND
+            for (uint32_t i = 0; i < n_out; i++) init[i] = (float)i - 7.0f;
+            TEST_ASSERT(ds4_gpu_tensor_write(b, 0, bh, n * sizeof(float)) != 0);
+            TEST_ASSERT(ds4_gpu_tensor_write(out, 0, init, (uint64_t)n_out * sizeof(float)) != 0);
+            TEST_ASSERT(ds4_gpu_tensor_write(wout, 0, init, (uint64_t)n_out * sizeof(float)) != 0);
+            uint32_t bad = 0;
+            double worst = 0.0;
+            for (int layer = 0; layer < 2; layer++) {
+                const float *prev = layer ? xh[0] : bh;
+                TEST_ASSERT(ds4_gpu_tensor_write(x, 0, xh[layer], n * sizeof(float)) != 0);
+                TEST_ASSERT(ds4_gpu_scope_rows_sumsq_tensor(x, out, b, wout, W, rows, off) != 0);
+                TEST_ASSERT(ds4_gpu_tensor_read(out, 0, o, (uint64_t)n_out * sizeof(float)) != 0);
+                TEST_ASSERT(ds4_gpu_tensor_read(wout, 0, wo, (uint64_t)n_out * sizeof(float)) != 0);
+                TEST_ASSERT(ds4_gpu_tensor_read(b, 0, got, n * sizeof(float)) != 0);
+                bad += memcmp(got, xh[layer], (size_t)n * sizeof(float)) != 0;     /* before holds this layer's rows */
+                for (uint32_t i = 0; i < n_out; i++) {
+                    if (i < off || i >= off + rows) {
+                        bad += o[i] != init[i] || wo[i] != init[i];
+                        continue;
+                    }
+                    const float *xr = xh[layer] + (uint64_t)(i - off) * W, *pr = prev + (uint64_t)(i - off) * W;
+                    double s = 0.0, d2 = 0.0;
+                    for (uint32_t j = 0; j < W; j++) {
+                        const double d = (double)xr[j] - pr[j];
+                        s += (double)xr[j] * xr[j];
+                        d2 += d * d;
+                    }
+                    const double e0 = fabs(o[i] - s) / s, e1 = fabs(wo[i] - d2) / (d2 + 1e-30);
+                    if (e0 > worst) worst = e0;
+                    if (e1 > worst) worst = e1;
+                    bad += e0 > 1e-4 || e1 > 1e-4;
+                }
+            }
+            fprintf(stderr, "ds4-test: scope rows sumsq width %u rows %u: worst rel err %.2e\n", W, rows, worst);
+            TEST_ASSERT(bad == 0);
+        }
+        free(xh[0]);
+        free(xh[1]);
+        free(bh);
+        free(got);
+        free(init);
+        free(o);
+        free(wo);
+        ds4_gpu_tensor_free(x);
+        ds4_gpu_tensor_free(b);
+        ds4_gpu_tensor_free(out);
+        ds4_gpu_tensor_free(wout);
+    }
+}
+
+/* metalscope's steering removal against a CPU reference in doubles: the rows'
+ * parts along k orthonormal directions (at q_row0 of a larger tensor) go to
+ * about 0 and every element is the reference's, rows past the steered ones
+ * keep their bits, and the add after it lands on the row without them. */
+static void test_metal_scope_remove_rows(void) {
+    static const struct { uint32_t width, rows, k, q_row0; } cases[] = {
+        { 10240, 3, 3, 2 },         /* Qwen3.8's 4 x 2560 */
+        { 20480, 9, DS4_SCOPE_MAX_REMOVE, 0 },    /* V4.1's 4 x 5120, the most directions */
+        { 100, 2, 1, 5 },
+    };
+    for (size_t c = 0; c < sizeof(cases) / sizeof(cases[0]); c++) {
+        const uint32_t W = cases[c].width, rows = cases[c].rows, k = cases[c].k, q0 = cases[c].q_row0;
+        const uint64_t x_count = (uint64_t)(rows + 2u) * W, q_count = (uint64_t)(q0 + k) * W;
+        ds4_gpu_tensor *x = ds4_gpu_tensor_alloc(x_count * sizeof(float));
+        ds4_gpu_tensor *q = ds4_gpu_tensor_alloc(q_count * sizeof(float));
+        float *xh = malloc((size_t)x_count * sizeof(float)), *got = malloc((size_t)x_count * sizeof(float));
+        float *qh = calloc((size_t)q_count, sizeof(float));
+        double *qd = malloc((size_t)k * W * sizeof(double));
+        TEST_ASSERT(x && q && xh && got && qh && qd);
+        if (x && q && xh && got && qh && qd) {
+            uint32_t seed = 777u + (uint32_t)c;
+            #define SCOPE_RAND() (seed = seed * 1664525u + 1013904223u, (double)((int32_t)(seed >> 8) % 20001 - 10000) * 1e-4)
+            for (uint32_t j = 0; j < k; j++) {          /* Gram-Schmidt, twice, in doubles */
+                double *d = qd + (size_t)j * W;
+                for (uint32_t i = 0; i < W; i++) d[i] = SCOPE_RAND();
+                for (int pass = 0; pass < 2; pass++) {
+                    for (uint32_t p = 0; p < j; p++) {
+                        double dot = 0.0;
+                        for (uint32_t i = 0; i < W; i++) dot += d[i] * qd[(size_t)p * W + i];
+                        for (uint32_t i = 0; i < W; i++) d[i] -= dot * qd[(size_t)p * W + i];
+                    }
+                }
+                double nn = 0.0;
+                for (uint32_t i = 0; i < W; i++) nn += d[i] * d[i];
+                for (uint32_t i = 0; i < W; i++) qh[(size_t)(q0 + j) * W + i] = (float)(d[i] /= sqrt(nn));
+            }
+            /* rows of unit-scale elements with a large part (norm about 100, as a residual's) along the first */
+            for (uint64_t i = 0; i < x_count; i++) xh[i] = (float)(SCOPE_RAND() + 100.0 * qd[i % W]);
+            #undef SCOPE_RAND
+            TEST_ASSERT(ds4_gpu_tensor_write(x, 0, xh, x_count * sizeof(float)) != 0);
+            TEST_ASSERT(ds4_gpu_tensor_write(q, 0, qh, q_count * sizeof(float)) != 0);
+            TEST_ASSERT(ds4_gpu_scope_remove_rows_tensor(x, q, q0, k, W, rows) != 0);
+            TEST_ASSERT(ds4_gpu_tensor_read(x, 0, got, x_count * sizeof(float)) != 0);
+            double worst_dot = 0.0, worst_el = 0.0, before = 0.0;
+            for (uint32_t r = 0; r < rows; r++) {
+                const float *x0 = xh + (size_t)r * W, *x1 = got + (size_t)r * W;
+                double dots[DS4_SCOPE_MAX_REMOVE];
+                for (uint32_t j = 0; j < k; j++) {
+                    const float *qj = qh + (size_t)(q0 + j) * W;    /* the directions as the kernel has them */
+                    double d0 = 0.0, d1 = 0.0;
+                    for (uint32_t i = 0; i < W; i++) {
+                        d0 += (double)x0[i] * qj[i];
+                        d1 += (double)x1[i] * qj[i];
+                    }
+                    dots[j] = d0;
+                    if (fabs(d0) > before) before = fabs(d0);
+                    if (fabs(d1) > worst_dot) worst_dot = fabs(d1);
+                }
+                for (uint32_t i = 0; i < W; i++) {
+                    double ref = x0[i];
+                    for (uint32_t j = 0; j < k; j++) ref -= dots[j] * qh[(size_t)(q0 + j) * W + i];
+                    const double e = fabs((double)x1[i] - ref);
+                    if (e > worst_el) worst_el = e;
+                }
+            }
+            fprintf(stderr, "ds4-test: scope remove width %u rows %u k %u: |x.q| %.1f -> %.2e, worst element err %.2e\n",
+                    W, rows, k, before, worst_dot, worst_el);
+            TEST_ASSERT(before > 50.0 && worst_dot < 1e-3 && worst_el < 1e-5);
+            TEST_ASSERT(!memcmp(got + (size_t)rows * W, xh + (size_t)rows * W, (size_t)2u * W * sizeof(float)));
+            /* then the add, as scope_steer orders them: the first direction's dot is the added vector's */
+            ds4_gpu_tensor *v = ds4_gpu_tensor_alloc((uint64_t)W * sizeof(float));
+            float *vh = malloc((size_t)W * sizeof(float));
+            TEST_ASSERT(v && vh);
+            if (v && vh) {
+                double vq = 0.0, worst = 0.0;
+                for (uint32_t i = 0; i < W; i++) {
+                    vh[i] = 3.0f * qh[(size_t)q0 * W + i] + (i % 5u ? 0.0f : 0.25f);
+                    vq += (double)vh[i] * qh[(size_t)q0 * W + i];
+                }
+                TEST_ASSERT(ds4_gpu_tensor_write(v, 0, vh, (uint64_t)W * sizeof(float)) != 0);
+                TEST_ASSERT(ds4_gpu_scope_add_rows_tensor(x, v, 0, W, rows) != 0);
+                TEST_ASSERT(ds4_gpu_tensor_read(x, 0, xh, x_count * sizeof(float)) != 0);
+                for (uint32_t r = 0; r < rows; r++) {
+                    double d = 0.0;
+                    for (uint32_t i = 0; i < W; i++) d += (double)xh[(size_t)r * W + i] * qh[(size_t)q0 * W + i];
+                    if (fabs(d - vq) > worst) worst = fabs(d - vq);
+                }
+                TEST_ASSERT(worst < 1e-3);
+                TEST_ASSERT(!memcmp(got + (size_t)rows * W, xh + (size_t)rows * W, (size_t)2u * W * sizeof(float)));
+            }
+            free(vh);
+            ds4_gpu_tensor_free(v);
+        }
+        free(xh);
+        free(got);
+        free(qh);
+        free(qd);
+        ds4_gpu_tensor_free(x);
+        ds4_gpu_tensor_free(q);
+    }
+}
+#endif
