diff --git a/ds4_metal_scope.inc b/ds4_metal_scope.inc
new file mode 100644
index 0000000..d847b3a
--- /dev/null
+++ b/ds4_metal_scope.inc
@@ -0,0 +1,330 @@
+/* metalscope capture and steering: the Metal side of ds4_gpu_scope.h, included
+ * by ds4_metal.m (it uses that file's pipeline and command-buffer helpers);
+ * the kernels are metal/scope.metal. */
+
+/* metalscope: out[out_off + r] = sum_i x[r][i]^2 and wout[out_off + r] = sum_i (x[r][i] - before[r][i])^2 for rows r
+ * of a width-wide f32 tensor, then before[r] = x[r]. */
+typedef struct {
+    uint32_t width;
+    uint32_t rows;
+    uint32_t out_off;
+    uint32_t n_threads;
+} ds4_gpu_scope_rows_sumsq_args;
+
+int ds4_gpu_scope_rows_sumsq_tensor(
+        const ds4_gpu_tensor *x,
+        ds4_gpu_tensor       *out,
+        ds4_gpu_tensor       *before,
+        ds4_gpu_tensor       *wout,
+        uint32_t              width,
+        uint32_t              rows,
+        uint32_t              out_off) {
+    if (!g_initialized && !ds4_gpu_init()) return 0;
+    if (!x || !out || !before || !wout || width == 0 || rows == 0) return 0;
+
+    @autoreleasepool {
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_scope_rows_sumsq_f32");
+        if (!pipeline) return 0;
+        ds4_gpu_kv_norm_task_end_concurrent();   /* the scope kernels rely on serial order */
+        id<MTLBuffer> xbuf = ds4_gpu_tensor_buffer(x);
+        id<MTLBuffer> obuf = ds4_gpu_tensor_buffer(out);
+        id<MTLBuffer> bbuf = ds4_gpu_tensor_buffer(before);
+        id<MTLBuffer> wbuf = ds4_gpu_tensor_buffer(wout);
+        if (!xbuf || !obuf || !bbuf || !wbuf ||
+            ds4_gpu_tensor_bytes(x) < (uint64_t)width * rows * sizeof(float) ||
+            ds4_gpu_tensor_bytes(before) < (uint64_t)width * rows * sizeof(float) ||
+            ds4_gpu_tensor_bytes(out) < ((uint64_t)out_off + rows) * sizeof(float) ||
+            ds4_gpu_tensor_bytes(wout) < ((uint64_t)out_off + rows) * sizeof(float)) {
+            fprintf(stderr, "ds4: Metal scope sumsq received undersized buffers\n");
+            return 0;
+        }
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        if (!cb) return 0;
+        NSUInteger nth = pipeline.maxTotalThreadsPerThreadgroup;
+        if (nth > 256u) nth = 256u;
+        while (nth > width && nth > 1u) nth >>= 1;
+        ds4_gpu_scope_rows_sumsq_args args = {
+            .width = width, .rows = rows, .out_off = out_off, .n_threads = (uint32_t)nth,
+        };
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBytes:&args length:sizeof(args) atIndex:0];
+        [enc setBuffer:xbuf offset:ds4_gpu_tensor_offset(x) atIndex:1];
+        [enc setBuffer:obuf offset:ds4_gpu_tensor_offset(out) atIndex:2];
+        [enc setBuffer:bbuf offset:ds4_gpu_tensor_offset(before) atIndex:3];
+        [enc setBuffer:wbuf offset:ds4_gpu_tensor_offset(wout) atIndex:4];
+        [enc setThreadgroupMemoryLength:2u * nth * sizeof(float) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)rows, 1, 1)
+             threadsPerThreadgroup:MTLSizeMake(nth, 1, 1)];
+        ds4_gpu_end_compute_encoder(cb, enc);
+        if (!ds4_gpu_finish_command_buffer(cb, owned, "scope sumsq")) return 0;
+    }
+    return 1;
+}
+
+/* metalscope: out[3 * (out_off + r) + {0,1,2}] = max, sum exp(z - max), sum exp(z - max) * z of each logit row. */
+int ds4_gpu_scope_row_stats_tensor(
+        const ds4_gpu_tensor *x,
+        ds4_gpu_tensor       *out,
+        uint32_t              width,
+        uint32_t              rows,
+        uint32_t              out_off) {
+    if (!g_initialized && !ds4_gpu_init()) return 0;
+    if (!x || !out || width == 0 || rows == 0) return 0;
+
+    @autoreleasepool {
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_scope_row_stats_f32");
+        if (!pipeline) return 0;
+        ds4_gpu_kv_norm_task_end_concurrent();
+        id<MTLBuffer> xbuf = ds4_gpu_tensor_buffer(x);
+        id<MTLBuffer> obuf = ds4_gpu_tensor_buffer(out);
+        if (!xbuf || !obuf ||
+            ds4_gpu_tensor_bytes(x) < (uint64_t)width * rows * sizeof(float) ||
+            ds4_gpu_tensor_bytes(out) < 3u * ((uint64_t)out_off + rows) * sizeof(float)) {
+            fprintf(stderr, "ds4: Metal scope row stats received undersized buffers\n");
+            return 0;
+        }
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        if (!cb) return 0;
+        NSUInteger nth = pipeline.maxTotalThreadsPerThreadgroup;
+        if (nth > 512u) nth = 512u;
+        while (nth > width && nth > 1u) nth >>= 1;
+        ds4_gpu_scope_rows_sumsq_args args = {
+            .width = width, .rows = rows, .out_off = out_off, .n_threads = (uint32_t)nth,
+        };
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBytes:&args length:sizeof(args) atIndex:0];
+        [enc setBuffer:xbuf offset:ds4_gpu_tensor_offset(x) atIndex:1];
+        [enc setBuffer:obuf offset:ds4_gpu_tensor_offset(out) atIndex:2];
+        [enc setThreadgroupMemoryLength:2u * nth * sizeof(float) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)rows, 1, 1)
+             threadsPerThreadgroup:MTLSizeMake(nth, 1, 1)];
+        ds4_gpu_end_compute_encoder(cb, enc);
+        if (!ds4_gpu_finish_command_buffer(cb, owned, "scope row stats")) return 0;
+    }
+    return 1;
+}
+
+/* metalscope: x[r][i] += v[layer * width + i] for every row r (additive steering). */
+typedef struct {
+    uint32_t width;
+    uint32_t rows;
+    uint32_t layer;
+    uint32_t pad;
+} ds4_gpu_scope_add_rows_args;
+
+int ds4_gpu_scope_add_rows_tensor(
+        ds4_gpu_tensor       *x,
+        const ds4_gpu_tensor *v,
+        uint32_t              layer,
+        uint32_t              width,
+        uint32_t              rows) {
+    if (!g_initialized && !ds4_gpu_init()) return 0;
+    if (!x || !v || width == 0 || rows == 0) return 0;
+
+    @autoreleasepool {
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_scope_add_rows_f32");
+        if (!pipeline) return 0;
+        ds4_gpu_kv_norm_task_end_concurrent();
+        id<MTLBuffer> xbuf = ds4_gpu_tensor_buffer(x);
+        id<MTLBuffer> vbuf = ds4_gpu_tensor_buffer(v);
+        const uint64_t n = (uint64_t)width * rows;
+        if (!xbuf || !vbuf || n > UINT32_MAX ||
+            ds4_gpu_tensor_bytes(x) < n * sizeof(float) ||
+            ds4_gpu_tensor_bytes(v) < ((uint64_t)layer + 1u) * width * sizeof(float)) {
+            fprintf(stderr, "ds4: Metal scope steering add received undersized buffers\n");
+            return 0;
+        }
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        if (!cb) return 0;
+        NSUInteger nth = pipeline.maxTotalThreadsPerThreadgroup;
+        if (nth > 256u) nth = 256u;
+        ds4_gpu_scope_add_rows_args args = { .width = width, .rows = rows, .layer = layer, .pad = 0 };
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBytes:&args length:sizeof(args) atIndex:0];
+        [enc setBuffer:xbuf offset:ds4_gpu_tensor_offset(x) atIndex:1];
+        [enc setBuffer:vbuf offset:ds4_gpu_tensor_offset(v) atIndex:2];
+        [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)((n + nth - 1u) / nth), 1, 1)
+             threadsPerThreadgroup:MTLSizeMake(nth, 1, 1)];
+        ds4_gpu_end_compute_encoder(cb, enc);
+        if (!ds4_gpu_finish_command_buffer(cb, owned, "scope steering add")) return 0;
+    }
+    return 1;
+}
+
+/* metalscope: x[r] -= sum_j (x[r] . q[q_row0 + j]) q[q_row0 + j] for every row r, j < n_q <= DS4_SCOPE_MAX_REMOVE orthonormal
+ * width-wide directions (steering's removal). */
+typedef struct {
+    uint32_t width;
+    uint32_t rows;
+    uint32_t q_row0;
+    uint32_t n_q;
+    uint32_t n_threads;
+    uint32_t pad;
+} ds4_gpu_scope_remove_rows_args;
+
+int ds4_gpu_scope_remove_rows_tensor(
+        ds4_gpu_tensor       *x,
+        const ds4_gpu_tensor *q,
+        uint32_t              q_row0,
+        uint32_t              n_q,
+        uint32_t              width,
+        uint32_t              rows) {
+    if (!g_initialized && !ds4_gpu_init()) return 0;
+    if (!x || !q || width == 0 || rows == 0 || n_q == 0 || n_q > DS4_SCOPE_MAX_REMOVE) return 0;
+
+    @autoreleasepool {
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_scope_remove_rows_f32");
+        if (!pipeline) return 0;
+        ds4_gpu_kv_norm_task_end_concurrent();
+        id<MTLBuffer> xbuf = ds4_gpu_tensor_buffer(x);
+        id<MTLBuffer> qbuf = ds4_gpu_tensor_buffer(q);
+        if (!xbuf || !qbuf ||
+            ds4_gpu_tensor_bytes(x) < (uint64_t)width * rows * sizeof(float) ||
+            ds4_gpu_tensor_bytes(q) < ((uint64_t)q_row0 + n_q) * width * sizeof(float)) {
+            fprintf(stderr, "ds4: Metal scope steering removal received undersized buffers\n");
+            return 0;
+        }
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        if (!cb) return 0;
+        NSUInteger nth = pipeline.maxTotalThreadsPerThreadgroup;
+        if (nth > 256u) nth = 256u;
+        while (nth > width && nth > 1u) nth >>= 1;
+        ds4_gpu_scope_remove_rows_args args = {
+            .width = width, .rows = rows, .q_row0 = q_row0, .n_q = n_q, .n_threads = (uint32_t)nth, .pad = 0,
+        };
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBytes:&args length:sizeof(args) atIndex:0];
+        [enc setBuffer:xbuf offset:ds4_gpu_tensor_offset(x) atIndex:1];
+        [enc setBuffer:qbuf offset:ds4_gpu_tensor_offset(q) atIndex:2];
+        [enc setThreadgroupMemoryLength:DS4_SCOPE_MAX_REMOVE * nth * sizeof(float) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)rows, 1, 1)
+             threadsPerThreadgroup:MTLSizeMake(nth, 1, 1)];
+        ds4_gpu_end_compute_encoder(cb, enc);
+        if (!ds4_gpu_finish_command_buffer(cb, owned, "scope steering removal")) return 0;
+    }
+    return 1;
+}
+
+/* metalscope: out[out_off + r * out_stride + j] = x[r * x_stride ..] . w[(w_row0 + j) * width ..] for rows r < rows,
+ * outputs j < n_out; w f16.  J-lens reads only. */
+typedef struct {
+    uint32_t width;
+    uint32_t n_out;
+    uint32_t rows;
+    uint32_t x_stride;
+    uint32_t w_row0;
+    uint32_t out_off;
+    uint32_t out_stride;
+    uint32_t pad;
+} ds4_gpu_scope_project_args;
+
+int ds4_gpu_scope_project_tensor(
+        const ds4_gpu_tensor *x,
+        uint32_t              x_stride,
+        const ds4_gpu_tensor *w,
+        uint32_t              w_row0,
+        uint32_t              width,
+        uint32_t              n_out,
+        uint32_t              rows,
+        ds4_gpu_tensor       *out,
+        uint32_t              out_off,
+        uint32_t              out_stride) {
+    if (!g_initialized && !ds4_gpu_init()) return 0;
+    if (!x || !w || !out || width == 0 || n_out == 0 || rows == 0) return 0;
+
+    @autoreleasepool {
+        id<MTLComputePipelineState> pipeline =
+            ds4_gpu_get_pipeline("kernel_scope_project_f16");
+        if (!pipeline) return 0;
+        ds4_gpu_kv_norm_task_end_concurrent();
+        id<MTLBuffer> xbuf = ds4_gpu_tensor_buffer(x);
+        id<MTLBuffer> wbuf = ds4_gpu_tensor_buffer(w);
+        id<MTLBuffer> obuf = ds4_gpu_tensor_buffer(out);
+        if (!xbuf || !wbuf || !obuf ||
+            ds4_gpu_tensor_bytes(x) < ((uint64_t)(rows - 1u) * x_stride + width) * sizeof(float) ||
+            ds4_gpu_tensor_bytes(w) < ((uint64_t)w_row0 + n_out) * width * 2u ||
+            ds4_gpu_tensor_bytes(out) < ((uint64_t)out_off + (uint64_t)(rows - 1u) * out_stride + n_out) * sizeof(float)) {
+            fprintf(stderr, "ds4: Metal scope projection received undersized buffers\n");
+            return 0;
+        }
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        if (!cb) return 0;
+        NSUInteger nth = pipeline.maxTotalThreadsPerThreadgroup;
+        if (nth > 256u) nth = 256u;
+        nth &= ~(NSUInteger)31u;
+        if (nth == 0) return 0;
+        ds4_gpu_scope_project_args args = {
+            .width = width, .n_out = n_out, .rows = rows, .x_stride = x_stride,
+            .w_row0 = w_row0, .out_off = out_off, .out_stride = out_stride, .pad = 0,
+        };
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBytes:&args length:sizeof(args) atIndex:0];
+        [enc setBuffer:xbuf offset:ds4_gpu_tensor_offset(x) atIndex:1];
+        [enc setBuffer:wbuf offset:ds4_gpu_tensor_offset(w) atIndex:2];
+        [enc setBuffer:obuf offset:ds4_gpu_tensor_offset(out) atIndex:3];
+        [enc setThreadgroupMemoryLength:(nth / 32u) * 64u * sizeof(float) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)((n_out + 7u) / 8u), (NSUInteger)((rows + 7u) / 8u), 1)
+             threadsPerThreadgroup:MTLSizeMake(nth, 1, 1)];
+        ds4_gpu_end_compute_encoder(cb, enc);
+        if (!ds4_gpu_finish_command_buffer(cb, owned, "scope projection")) return 0;
+    }
+    return 1;
+}
+
+/* metalscope: out[out_off + i] += sum_{r < rows} x[(row0 + r) * width + i] for i < width (residual sums). */
+typedef struct {
+    uint32_t width;
+    uint32_t row0;
+    uint32_t rows;
+    uint32_t out_off;
+} ds4_gpu_scope_rows_accum_args;
+
+int ds4_gpu_scope_rows_accum_tensor(
+        const ds4_gpu_tensor *x,
+        uint32_t              width,
+        uint32_t              row0,
+        uint32_t              rows,
+        ds4_gpu_tensor       *out,
+        uint32_t              out_off) {
+    if (!g_initialized && !ds4_gpu_init()) return 0;
+    if (!x || !out || width == 0 || rows == 0) return 0;
+
+    @autoreleasepool {
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_scope_rows_accum_f32");
+        if (!pipeline) return 0;
+        ds4_gpu_kv_norm_task_end_concurrent();
+        id<MTLBuffer> xbuf = ds4_gpu_tensor_buffer(x);
+        id<MTLBuffer> obuf = ds4_gpu_tensor_buffer(out);
+        if (!xbuf || !obuf || pipeline.maxTotalThreadsPerThreadgroup < 256u ||
+            ds4_gpu_tensor_bytes(x) < ((uint64_t)row0 + rows) * width * sizeof(float) ||
+            ds4_gpu_tensor_bytes(out) < ((uint64_t)out_off + width) * sizeof(float)) {
+            fprintf(stderr, "ds4: Metal scope residual sum received undersized buffers\n");
+            return 0;
+        }
+        int owned = 0;
+        id<MTLCommandBuffer> cb = ds4_gpu_command_buffer(&owned);
+        if (!cb) return 0;
+        ds4_gpu_scope_rows_accum_args args = { .width = width, .row0 = row0, .rows = rows, .out_off = out_off };
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBytes:&args length:sizeof(args) atIndex:0];
+        [enc setBuffer:xbuf offset:ds4_gpu_tensor_offset(x) atIndex:1];
+        [enc setBuffer:obuf offset:ds4_gpu_tensor_offset(out) atIndex:2];
+        [enc setThreadgroupMemoryLength:256u * sizeof(float) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)((width + 63u) / 64u), 1, 1)
+             threadsPerThreadgroup:MTLSizeMake(256u, 1, 1)];
+        ds4_gpu_end_compute_encoder(cb, enc);
+        if (!ds4_gpu_finish_command_buffer(cb, owned, "scope residual sum")) return 0;
+    }
+    return 1;
+}
diff --git a/ds4_scope.h b/ds4_scope.h
new file mode 100644
index 0000000..87cd1b2
--- /dev/null
+++ b/ds4_scope.h
@@ -0,0 +1,57 @@
+#ifndef DS4_SCOPE_H
+#define DS4_SCOPE_H
+
+/* Included by ds4.h, after the session API it extends. */
+
+/* metalscope: one request's capture (a binary record per forward pass,
+ * written to trace_path) and steering (steer_path: per-layer directions taken
+ * out of the whole residual row after their layer, then vectors added to
+ * it).  Metal, single host,
+ * Qwen3.8 and DeepSeek V4.1.  A scoped request reuses the rows the session
+ * holds as one without a scope does when they were computed under the same
+ * steering, and records only the rows it feeds; else begin invalidates the
+ * session (ds4_scope_session.inc says when).  end writes the request's sampled
+ * tokens, closes the file and drops the steering; the session remembers the
+ * steering its rows were computed under.  The file format is described in
+ * ds4_scope.inc. */
+#define DS4_SCOPE_MAX_LENS 64u      /* logit-lens layers, and J-lens layers */
+#define DS4_SCOPE_MAX_IDS 256u      /* ids the output is read at (LIDS) */
+typedef struct {
+    const char *trace_path;     /* NULL: steering only */
+    const char *steer_path;     /* NULL: no steering */
+    int topk;                   /* final and lens top-k, 1..32; 0: 10 */
+    int n_lens;                 /* logit-lens layers (trunk indices), <= DS4_SCOPE_MAX_LENS */
+    const int *lens_layers;
+    bool steer_decode_only;     /* steer decode forwards only (positions=decode) */
+    const char *jlens_path;     /* NULL: no J-lens; else a DS4JLENS file read on the head rows (Qwen3.8, traced) */
+    bool rsum;                  /* residual sums (RSUM): every layer's prompt rows from rsum_sink on, and its last (traced) */
+    int rsum_sink;
+    int n_logit_ids;            /* the output's log-probability at these ids on every head row (LIDS; traced, <= DS4_SCOPE_MAX_IDS) */
+    const int *logit_ids;
+    bool fresh;                 /* read every prompt row: no reuse of the rows the session holds */
+    int next_lp;                /* > 0: every prompt row from next_lp - 1 on, its next token's log-probability (NXLP) and top 10 (NXTK; traced; V4.1 feeds those rows one at a time) */
+    bool lookup_off;            /* the n-gram lookup adds nothing (Qwen3.8's PLE, V4.1's Engram); the session's rows are dropped before and after */
+} ds4_scope_cfg;
+int ds4_session_scope_begin(ds4_session *s, const ds4_scope_cfg *cfg, char *err, size_t errlen);
+void ds4_session_scope_output(ds4_session *s, int token);
+/* The request's whole prompt, before its first prefill (a sync may feed it
+ * in parts: the record and positions=decode steering need its length), and
+ * again once the server knows the live state it reuses: the tokens it syncs. */
+void ds4_session_scope_prompt(ds4_session *s, const ds4_tokens *prompt);
+void ds4_session_scope_end(ds4_session *s, const char *finish);
+bool ds4_session_scope_active(ds4_session *s);
+/* A request without a scope begins: true when the session's rows were steered and it was emptied. */
+bool ds4_session_scope_none(ds4_session *s);
+/* Kept out of the disk KV cache: a scoped request runs, or the session's rows were steered. */
+bool ds4_session_scope_private(ds4_session *s);
+/* Around the server's sync of text it inserts mid-reply (a tool error after an invalid tool call): end with the
+ * synced target (NULL when the sync failed) and the position it was appended at. */
+void ds4_session_scope_insert_begin(ds4_session *s);
+void ds4_session_scope_insert_end(ds4_session *s, const ds4_tokens *target, int before);
+/* Whether a scoped request may decode speculatively (Qwen3.8's MTP: yes). */
+bool ds4_session_scope_allows_speculation(ds4_session *s);
+/* The trace file begin writes, created new: NULL when the name exists (a file, a symlink, a FIFO) or a directory on
+ * the way is a symlink, so a request never truncates or follows a file it did not create. */
+FILE *ds4_scope_trace_create(const char *path);
+
+#endif
diff --git a/ds4_scope.inc b/ds4_scope.inc
new file mode 100644
index 0000000..f4c5d21
--- /dev/null
+++ b/ds4_scope.inc
@@ -0,0 +1,750 @@
+/* =========================================================================
+ * metalscope: per-request capture and steering.
+ * =========================================================================
+ * ds4_session_scope_begin hands the session's graph a ds4_scope.  The graph
+ * then works inside each forward's own command batch, so a traced forward
+ * adds no GPU synchronisation:
+ *   - after every traced layer it takes the request's removed directions
+ *     for that layer out of the whole residual row (all hyper-connection
+ *     streams) and adds the request's steering vector for that layer to it,
+ *     then stages every row's routed experts, their mixing weights, each
+ *     stream's sum of squares and the sum of squares of what the layer changed
+ *     in it, and the forward's last row whole (with residual sums on, it also
+ *     adds the prompt rows into that layer's sum);
+ *   - what a layer changed is its output streams (as staged, after its
+ *     steering) less the streams it read, every write of the layer included
+ *     (attention, MLP, the n-gram lookup): the graph copies the streams a
+ *     forward's first layer reads into `before` (scope_streams_in; V4.1's
+ *     prefill sweep at every layer of each chunk, since a chunk's rows change
+ *     from layer to layer), and each traced layer's staging leaves its output
+ *     there (scope_resid), the next layer's input;
+ *   - after the output head it mixes the staged last rows as the head does
+ *     (hyper-connection collapse and output norm), reads the logit lens at
+ *     the chosen layers through the LM head, and takes each logit row's
+ *     softmax statistics.
+ * When the batch has completed, scope_emit_forward writes one STEP record.
+ * The head reads a forward's last row, or all its rows in an MTP verify
+ * (each accepted row is a reply token); a verify's record waits until the
+ * draft is judged and keeps the accepted rows only.
+ * ds4.c includes this file before its graphs, which call the hooks below;
+ * the graphs' own parts are ds4_scope_ds41.inc and ds4_scope_qwen4.inc, the
+ * session API ds4_scope_session.inc.
+ *
+ * File, little endian:
+ *   header  "DS4SCOPE", u32 version (6), family (1 Qwen3.8, 2 DeepSeek V4.1),
+ *           n_layer, n_hc, n_embd, n_expert_used, n_expert, n_vocab, topk,
+ *           n_lens, lens[n_lens]
+ *   records u32 tag, u32 payload bytes, payload:
+ *     JLNS  u32 nj, u32 layers[nj]                 the J-lens layers read (right after the header)
+ *     LIDS  u32 n, i32 ids[n]                      the ids flags & 64 reads (right after the header)
+ *     PRMT  u32 n, i32 prompt[n]                   the prompt, before its prefill (the last PRMT holds)
+ *     STEP  u32 pos0, u32 T, u32 flags (1 output, 2 lens, 4 resid norm, 16 J-lens, 64 output at LIDS),
+ *           u32 R,
+ *           i32 tokens[T], i32 experts[L][T][k], f32 weights[L][T][k],
+ *           f32 stream_norm[L][T][hc],
+ *           f32 write_norm[L][T][hc]               the norm of what the layer changed in the stream: its
+ *                                                  output less its input (layer 0's: the embedding's)
+ *           then for the last R rows (the ones the head read):
+ *           flags & 4: f32 resid_norm[R][L]        as the head reads the row
+ *           flags & 2: i32 ids[R][n_lens][topk], f32 logp[R][n_lens][topk]
+ *           flags & 16: i32 ids[R][nj][topk], f32 logp[R][nj][topk]
+ *           flags & 1: i32 ids[R][topk], f32 logp[R][topk], f32 entropy[R]
+ *                                                  the row's next-token distribution
+ *           flags & 64: f32 logp[R][n]             that distribution at the LIDS ids
+ *     RWND  u32 pos                                the session dropped positions pos..: the rows
+ *                                                  fed there next replace the ones written
+ *     SUFX  u32 pos, u32 n                         n tokens of text the server inserted into the reply at pos
+ *                                                  (a tool error): fed, not sampled; END_'s reply
+ *                                                  holds them
+ *     RSUM  u32 L, u32 W (n_hc * n_embd), u32 sink, u32 n[L], f32 sum[L][W], f32 last[L][W]
+ *                                                  residual sums, written at the end (before END_): per layer
+ *                                                  the sum of its n prompt rows from position sink on (sink:
+ *                                                  at most the prompt's last; each position once, a replay adds
+ *                                                  nothing) and the prompt's last row (NaN where not computed)
+ *     NXLP  u32 pos0, u32 n, f32 lp[n]             lp[i]: the log-probability of the prompt's token at pos0 + i + 1
+ *                                                  read at row pos0 + i (scope next_lp), one record a forward
+ *     NXTK  u32 pos0, u32 n, u32 k, i32 ids[n][k], f32 logp[n][k]
+ *                                                  the same rows' top k next tokens (k DS4_SCOPE_NX_TOP),
+ *                                                  descending: right after each NXLP
+ *     END_  u32 n, i32 sampled[n], u32 len, char finish[len]
+ *                                                  finish: the server's ("done", "cancelled", ...), then
+ *                                                  "; trace stopped: <why>" when records stopped partway; none
+ *                                                  after a failed write (the file ends where the write failed)
+ * Rows are positions pos0 .. pos0 + T - 1.  Without a RWND before it, a
+ * forward over positions already written (a replay of the same tokens) adds
+ * nothing: the reader keeps the first record there.  A request that reuses the
+ * rows the session holds (ds4_session_scope_begin) records from the first
+ * position it feeds: its first STEP may start past 0, and PRMT still holds the
+ * whole prompt.
+ */
+#define DS4_SCOPE_VERSION 6u
+#define DS4_SCOPE_MAX_TOPK 32u
+/* Head-read rows a forward may stage: an MTP verify's, ds4_session_qwen4_spec_cycle's toks[3] (T = deep ? 3 : 2).
+ * A wider verify stops the trace (scope_resid) rather than overrun the staging. */
+#define DS4_SCOPE_HEAD_ROWS 3u
+#define DS4_SCOPE_FAMILY_QWEN4 1u
+#define DS4_SCOPE_FAMILY_DS41 2u
+
+typedef struct ds4_scope ds4_scope;
+
+static void scope_session_sync(ds4_session *s, const ds4_tokens *prompt);
+static void scope_note_rewind(ds4_session *s, int pos);
+static void scope_session_decode(ds4_session *s);
+static void scope_session_free(ds4_session *s);
+
+#ifndef DS4_NO_GPU
+struct ds4_scope {
+    FILE *fp;                         /* NULL: steering only */
+    uint32_t family, n_layer, cap, topk, n_lens;
+    uint32_t n_lens_cap;              /* the lens rows (logit and J-lens) the staging was sized for */
+    uint32_t lens[DS4_SCOPE_MAX_LENS];
+    /* J-lens (DS4JLENS, cached while the file is unchanged): per layer
+     * J [n_embd][n_hc * n_embd] f16, read on the head rows beside the logit
+     * lens; jlens_on: this request reads it. */
+    char *jlens_path;
+    int64_t jlens_mtime, jlens_size;
+    uint32_t n_jlens;
+    uint32_t jlens[DS4_SCOPE_MAX_LENS];
+    ds4_gpu_tensor *jlens_w;
+    bool jlens_on;
+    bool prompt_written;
+    uint32_t prompt_len;              /* the request's prompt (PRMT), 0 until known */
+    bool decoding;                    /* a decode eval has run since begin */
+    bool steer_decode_only;
+    bool steer_any;
+    uint64_t steer_sig;               /* the loaded vectors' signature (scope_load_steering), never 0 */
+    uint8_t steer_layer[DS4_MAX_LAYER];
+    ds4_gpu_tensor *steer_vec;        /* [n_layer][n_hc * n_embd], already scaled */
+    /* Removal: layer il's rem_n[il] orthonormal directions, rows rem_row[il] .. of rem_q, projected out of the
+     * steered rows before the add. */
+    uint8_t rem_n[DS4_MAX_LAYER];
+    uint32_t rem_row[DS4_MAX_LAYER];
+    ds4_gpu_tensor *rem_q;            /* [rem_q_rows][n_hc * n_embd] f32 */
+    uint32_t rem_q_rows;              /* the directions rem_q holds room for */
+    /* GPU staging, sized for cap rows per forward */
+    ds4_gpu_tensor *sel, *w, *sumsq;  /* [L][cap][k] i32, [L][cap][k] f32, [L][cap][n_hc] f32 */
+    ds4_gpu_tensor *wsumsq;           /* [L][cap][n_hc] f32: what each layer changed in each stream, squared */
+    /* The streams the next traced layer reads, [before_rows][n_hc * n_embd] f32: sized for the forward at its start
+     * (scope_before_fit), not for cap (a V4.1 prefill chunk's rows are hundreds of MB). */
+    ds4_gpu_tensor *before;
+    uint32_t before_rows;
+    /* The head-read rows (R of them, the forward's last; head_rows) after each layer: */
+    ds4_gpu_tensor *res;              /* [L][R][n_hc * n_embd] */
+    ds4_gpu_tensor *pre;              /* V4.1: [L][R][n_hc] the head's collapse weights */
+    ds4_gpu_tensor *mixed;            /* [L][R][n_embd]: those rows as the head reads them */
+    ds4_gpu_tensor *mixed_save;       /* [R][n_embd]: the graph's own mixed rows, restored after the lens */
+    ds4_gpu_tensor *lens_in;          /* [R][n_lens][n_embd] (and 32 spare rows) */
+    ds4_gpu_tensor *lens_x;           /* V4.1: lens_in after the output norm */
+    ds4_gpu_tensor *lens_logits;      /* [R][n_lens][n_vocab] (and 32 spare rows) */
+    ds4_gpu_tensor *stats;            /* softmax statistics: [R][n_lens][3] then the outputs' [R][3] */
+    /* Residual sums (RSUM): per layer the prompt rows from rsum_sink on, each position once (rsum_next: the
+     * next position a layer adds), and the prompt's last row. */
+    bool rsum_on;
+    uint32_t rsum_sink;
+    uint32_t rsum_n[DS4_MAX_LAYER], rsum_next[DS4_MAX_LAYER];
+    ds4_gpu_tensor *rsum, *rsum_last; /* [n_layer][n_hc * n_embd] */
+    /* The output's log-probability at these ids on every head row (LIDS, STEP flag 64). */
+    uint32_t n_ids;
+    int32_t ids[DS4_SCOPE_MAX_IDS];
+    uint32_t head_rows;               /* R of the staged forward */
+    bool staged_head;                 /* this forward ran the head stage */
+    bool staged_output;               /* ... and took the output rows' statistics */
+    /* V4.1 computes a forward's output head in a separate batch (and a
+     * prefill's only after its last forward), so its record waits here until
+     * the head runs or the next forward starts. */
+    bool pending;
+    uint32_t pending_pos, pending_T;
+    int32_t *pending_tokens;          /* [cap] */
+    uint8_t *host;
+    size_t host_cap;
+    ds4_tokens out;
+    bool failed;                      /* the trace stopped (stopped: why); steering goes on */
+    bool write_failed;                /* ... at a failed write: nothing more is written */
+    char stopped[200];
+    bool frozen;                      /* the reply is over (a re-rendering sync after it): no more records */
+    bool inserting;                   /* the server's tool-error suffix sync is under way */
+    /* Next-token log-probabilities (NXLP, NXTK): rows from nx_from - 1 on, each read at the prompt's next token
+     * (nx_prompt, nx_len) and at its top DS4_SCOPE_NX_TOP. Qwen3.8: through the head in tiles of
+     * DS4_SCOPE_NX_TILE (nx_logits, nx_stats); V4.1: fed one at a time, each through the forward's own head. */
+    uint32_t nx_from, nx_len;
+    int32_t *nx_prompt;
+    ds4_gpu_tensor *nx_logits, *nx_stats;
+    bool lookup_off;                  /* the n-gram lookup adds nothing: Qwen3.8's PLE, V4.1's Engram (the session's
+                                         rows are dropped at begin and end) */
+};
+#define DS4_SCOPE_NX_TILE 256u
+#define DS4_SCOPE_NX_TOP 10u
+
+/* The trace stops here (steering goes on): the first reason is kept for END_. */
+static void scope_fail(ds4_scope *sc, const char *what) {
+    if (!sc->failed) {
+        fprintf(stderr, "ds4: scope: %s%s\n", what, sc->fp ? "; the trace stops here" : "");
+        snprintf(sc->stopped, sizeof(sc->stopped), "%s", what);
+    }
+    sc->failed = true;
+}
+
+/* A record may now be cut short: nothing more is written, END_ included, so the reader finds no end record. */
+static void scope_write_fail(ds4_scope *sc) {
+    scope_fail(sc, "trace write failed");
+    sc->write_failed = true;
+}
+
+static bool scope_tracing(const ds4_scope *sc) {
+    return sc && sc->fp && !sc->failed && !sc->frozen;
+}
+
+/* How many of a forward's last rows (positions pos0 .. pos0 + T - 1) get the
+ * steering (a removal, a vector) at layer il: all of them, or with
+ * positions=decode only decode forwards and the prompt's last row (it chooses
+ * the first reply token, as oMLX's first decode forward does), else none. */
+static uint32_t scope_steer_rows(const ds4_scope *sc, uint32_t il, uint32_t pos0, uint32_t T) {
+    if (!sc || !sc->steer_any || il >= DS4_MAX_LAYER || !(sc->steer_layer[il] || sc->rem_n[il]) || T == 0) return 0;
+    if (!sc->steer_decode_only) return T;
+    /* By position, so a replay of the context after a rewind leaves the
+     * prompt unsteered: the rows from the prompt's last on. */
+    if (!sc->prompt_len) return sc->decoding ? T : 0u;
+    const uint32_t from = sc->prompt_len - 1u;
+    return pos0 + T <= from ? 0u : pos0 >= from ? T : pos0 + T - from;
+}
+
+static void scope_put(ds4_scope *sc, const void *p, size_t bytes) {
+    if (!sc->write_failed && bytes && fwrite(p, 1, bytes, sc->fp) != bytes) scope_write_fail(sc);
+}
+
+static void scope_record(ds4_scope *sc, const char tag[4], uint32_t bytes) {
+    scope_put(sc, tag, 4);
+    scope_put(sc, &bytes, sizeof(bytes));
+}
+
+static void scope_flush(ds4_scope *sc) {
+    if (!sc->write_failed && fflush(sc->fp) != 0) scope_write_fail(sc);
+}
+
+static void scope_put_u32(ds4_scope *sc, uint32_t v) {
+    scope_put(sc, &v, sizeof(v));
+}
+
+static void *scope_host(ds4_scope *sc, size_t bytes) {
+    if (bytes > sc->host_cap) {
+        sc->host = xrealloc(sc->host, bytes);
+        sc->host_cap = bytes;
+    }
+    return sc->host;
+}
+
+static void scope_free_gpu(ds4_scope *sc) {
+    ds4_gpu_tensor **t[] = {&sc->sel, &sc->w, &sc->sumsq, &sc->wsumsq, &sc->before, &sc->res, &sc->pre,
+                            &sc->mixed, &sc->mixed_save,
+                            &sc->lens_in, &sc->lens_x, &sc->lens_logits, &sc->stats, &sc->steer_vec,
+                            &sc->jlens_w,
+                            &sc->rsum, &sc->rsum_last, &sc->rem_q, &sc->nx_logits, &sc->nx_stats};
+    for (size_t i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+        ds4_gpu_tensor_free(*t[i]);
+        *t[i] = NULL;
+    }
+    free(sc->pending_tokens);
+    sc->pending_tokens = NULL;
+    free(sc->jlens_path);
+    sc->jlens_path = NULL;
+    sc->n_jlens = sc->rem_q_rows = sc->before_rows = 0;
+    sc->jlens_on = false;
+    sc->rsum_on = false;
+}
+
+static void scope_destroy(ds4_scope *sc) {
+    scope_free_gpu(sc);
+    free(sc->host);
+    free(sc->nx_prompt);
+    ds4_tokens_free(&sc->out);
+    free(sc);
+}
+
+/* The J-lens layers this request reads (none with the J-lens off). */
+static uint32_t scope_nj(const ds4_scope *sc) {
+    return sc && sc->jlens_on ? sc->n_jlens : 0u;
+}
+
+/* Row of the stats (and of lens_in / lens_logits) where the outputs' statistics start: after the logit lens's
+ * HR * n_lens rows and the J-lens's HR * nj. */
+static uint32_t scope_out_stats_row(const ds4_scope *sc, uint32_t HR) {
+    return HR * (sc->n_lens + scope_nj(sc));
+}
+
+/* Staging for n_layer traced layers, up to cap rows per forward and n_rows lens layers (logit and J-lens). */
+static bool scope_alloc(ds4_scope *sc, uint32_t family, uint32_t n_layer, uint32_t cap, uint32_t n_rows) {
+    const uint64_t L = n_layer, k = DS4_N_EXPERT_USED, hc = DS4_N_HC, E = DS4_N_EMBD;
+    /* The lens buffers hold 32 rows past the lens's: Qwen's batched Q8 head
+     * kernel computes whole 32-row tiles, the extra rows as scratch. */
+    const uint64_t V = DS4_N_VOCAB, HR = DS4_SCOPE_HEAD_ROWS, nl = (uint64_t)n_rows * HR + 32u;
+    sc->family = family;
+    sc->n_layer = n_layer;
+    sc->cap = cap;
+    sc->n_lens_cap = n_rows;
+    sc->sel = ds4_gpu_tensor_alloc(L * cap * k * sizeof(int32_t));
+    sc->w = ds4_gpu_tensor_alloc(L * cap * k * sizeof(float));
+    sc->sumsq = ds4_gpu_tensor_alloc(L * cap * hc * sizeof(float));
+    sc->wsumsq = ds4_gpu_tensor_alloc(L * cap * hc * sizeof(float));
+    sc->res = ds4_gpu_tensor_alloc(L * HR * hc * E * sizeof(float));
+    sc->pre = ds4_gpu_tensor_alloc(L * HR * hc * sizeof(float));
+    sc->mixed = ds4_gpu_tensor_alloc(L * HR * E * sizeof(float));
+    sc->mixed_save = ds4_gpu_tensor_alloc(HR * E * sizeof(float));
+    sc->lens_in = ds4_gpu_tensor_alloc(nl * E * sizeof(float));
+    sc->lens_x = ds4_gpu_tensor_alloc(nl * E * sizeof(float));
+    sc->lens_logits = ds4_gpu_tensor_alloc(nl * V * sizeof(float));
+    sc->stats = ds4_gpu_tensor_alloc(((uint64_t)n_rows + 1u) * HR * 3u * sizeof(float));
+    sc->pending_tokens = xmalloc((size_t)cap * sizeof(int32_t));
+    return sc->sel && sc->w && sc->sumsq && sc->wsumsq && sc->res && sc->pre && sc->mixed && sc->mixed_save &&
+           sc->lens_in && sc->lens_x && sc->lens_logits && sc->stats;
+}
+
+/* Rows a forward may not compute at every layer (V4.1's layer-major prefill
+ * runs its deep layers on a suffix) read back empty: ids -1, weights and
+ * norms NaN.  Host writes to shared buffers, between batches. */
+static void scope_clear_rows(ds4_scope *sc, uint32_t T) {
+    const uint32_t k = DS4_N_EXPERT_USED, hc = DS4_N_HC;
+    uint8_t *sel = ds4_gpu_tensor_contents(sc->sel), *w = ds4_gpu_tensor_contents(sc->w);
+    uint8_t *sq = ds4_gpu_tensor_contents(sc->sumsq), *wsq = ds4_gpu_tensor_contents(sc->wsumsq);
+    if (T > sc->cap) {
+        scope_fail(sc, "forward wider than the staging");
+        return;
+    }
+    if (!sel || !w || !sq || !wsq) return;
+    for (uint32_t il = 0; il < sc->n_layer; il++) {
+        memset(sel + (uint64_t)il * sc->cap * k * 4u, 0xff, (size_t)T * k * 4u);
+        memset(w + (uint64_t)il * sc->cap * k * 4u, 0xff, (size_t)T * k * 4u);
+        memset(sq + (uint64_t)il * sc->cap * hc * 4u, 0xff, (size_t)T * hc * 4u);
+        memset(wsq + (uint64_t)il * sc->cap * hc * 4u, 0xff, (size_t)T * hc * 4u);
+    }
+}
+
+/* The k largest of z[0..n) in descending order, by a single pass that only
+ * inserts what beats the current k-th.  (-FLT_MAX, not -INFINITY: ds4
+ * builds with -ffast-math.) */
+static void scope_topk_row(const float *z, uint32_t n, uint32_t k, int32_t *ids, float *top) {
+    for (uint32_t j = 0; j < k; j++) {
+        ids[j] = -1;
+        top[j] = -FLT_MAX;
+    }
+    float floor_ = -FLT_MAX;
+    for (uint32_t i = 0; i < n; i++) {
+        const float v = z[i];
+        if (!(v > floor_)) continue;
+        uint32_t j = k - 1u;
+        while (j > 0 && top[j - 1u] < v) {
+            top[j] = top[j - 1u];
+            ids[j] = ids[j - 1u];
+            j--;
+        }
+        top[j] = v;
+        ids[j] = (int32_t)i;
+        floor_ = top[k - 1u];
+    }
+}
+
+/* log sum exp(z) of a logit row from its softmax statistics (max, sum exp(z - max), sum exp(z - max) z). */
+static float scope_lse(const float *stats) {
+    return stats[0] + logf(stats[1] > 0.0f ? stats[1] : 1.0f);
+}
+
+/* Top-k ids, log-probabilities and the entropy (nats; NULL: not wanted) of one logit row,
+ * from its softmax statistics. */
+static void scope_dist_row(const float *z, uint32_t n, uint32_t k, const float *stats,
+                           int32_t *ids, float *logp, float *entropy) {
+    scope_topk_row(z, n, k, ids, logp);
+    const float lse = scope_lse(stats);
+    for (uint32_t j = 0; j < k; j++) logp[j] = ids[j] >= 0 ? logp[j] - lse : -FLT_MAX;
+    if (entropy) *entropy = lse - stats[2] / (stats[1] > 0.0f ? stats[1] : 1.0f);
+}
+
+typedef struct {
+    const float *z;
+    const float *stats;
+    uint32_t n, k, row0, rows;
+    int32_t *ids;
+    float *logp;
+} scope_dist_job;
+
+static void *scope_dist_worker(void *arg) {
+    scope_dist_job *j = arg;
+    for (uint32_t r = j->row0; r < j->row0 + j->rows; r++) {
+        scope_dist_row(j->z + (uint64_t)r * j->n, j->n, j->k, j->stats + 3u * r,
+                       j->ids + (uint64_t)r * j->k, j->logp + (uint64_t)r * j->k, NULL);
+    }
+    return NULL;
+}
+
+/* scope_dist_row over many rows without the entropy, split across a few threads (the lens reads
+ * a quarter of a million logits per layer). */
+static void scope_dist_rows(const float *z, uint32_t rows, uint32_t n, uint32_t k, const float *stats,
+                            int32_t *ids, float *logp) {
+    enum { MAX_THREADS = 8 };
+    const uint32_t nt = rows < MAX_THREADS ? rows : MAX_THREADS;
+    pthread_t th[MAX_THREADS];
+    scope_dist_job jobs[MAX_THREADS];
+    bool started[MAX_THREADS] = {false};
+    uint32_t row = 0;
+    for (uint32_t t = 0; t < nt; t++) {
+        const uint32_t take = (rows - row) / (nt - t);
+        jobs[t] = (scope_dist_job){z, stats, n, k, row, take, ids, logp};
+        row += take;
+        started[t] = t > 0 && pthread_create(&th[t], NULL, scope_dist_worker, &jobs[t]) == 0;
+        if (t > 0 && !started[t]) scope_dist_worker(&jobs[t]);
+    }
+    if (nt) scope_dist_worker(&jobs[0]);
+    for (uint32_t t = 1; t < nt; t++) if (started[t]) pthread_join(th[t], NULL);
+}
+
+/* NXLP and NXTK for rows pos0 .. pos0 + n - 1: each one's log-probability of the prompt's next token, then its
+ * top k ids and log-probabilities. */
+static void scope_put_next_lp(ds4_scope *sc, uint32_t pos0, uint32_t n, uint32_t k, const float *lp,
+                              const int32_t *top_ids, const float *top_lp) {
+    scope_record(sc, "NXLP", 8u + 4u * n);
+    scope_put_u32(sc, pos0);
+    scope_put_u32(sc, n);
+    scope_put(sc, lp, (size_t)n * sizeof(float));
+    scope_record(sc, "NXTK", 12u + 8u * n * k);
+    scope_put_u32(sc, pos0);
+    scope_put_u32(sc, n);
+    scope_put_u32(sc, k);
+    scope_put(sc, top_ids, (size_t)n * k * sizeof(int32_t));
+    scope_put(sc, top_lp, (size_t)n * k * sizeof(float));
+}
+
+static void scope_write_header(ds4_scope *sc) {
+    scope_put(sc, "DS4SCOPE", 8);
+    const uint32_t head[] = {DS4_SCOPE_VERSION, sc->family, sc->n_layer, DS4_N_HC, DS4_N_EMBD, DS4_N_EXPERT_USED,
+                             DS4_N_EXPERT, DS4_N_VOCAB, sc->topk, sc->n_lens};
+    scope_put(sc, head, sizeof(head));
+    scope_put(sc, sc->lens, sc->n_lens * sizeof(uint32_t));
+    const uint32_t nj = scope_nj(sc);
+    if (nj) {
+        scope_record(sc, "JLNS", 4u + 4u * nj);
+        scope_put_u32(sc, nj);
+        scope_put(sc, sc->jlens, (size_t)nj * sizeof(uint32_t));
+    }
+    if (sc->n_ids) {
+        scope_record(sc, "LIDS", 4u + 4u * sc->n_ids);
+        scope_put_u32(sc, sc->n_ids);
+        scope_put(sc, sc->ids, (size_t)sc->n_ids * sizeof(int32_t));
+    }
+    scope_flush(sc);
+}
+
+/* The prompt record: the server writes the request's whole prompt before
+ * the first prefill (ds4_session_scope_prompt); a sync that feeds part of it
+ * (a prefill quantum) leaves it be, a longer one is written again (the
+ * reader keeps the last). */
+static void scope_write_prompt(ds4_scope *sc, const ds4_tokens *prompt) {
+    /* Once decoding, a sync appends to the reply (a tool-error suffix): not the prompt. */
+    if (!sc || !prompt || prompt->len <= 0 || sc->decoding ||
+        (sc->prompt_written && (uint32_t)prompt->len <= sc->prompt_len)) return;
+    sc->prompt_written = true;
+    sc->prompt_len = (uint32_t)prompt->len;
+    if (sc->nx_from) {          /* NXLP reads each row at the prompt's next token */
+        sc->nx_prompt = xrealloc(sc->nx_prompt, (size_t)prompt->len * sizeof(int32_t));
+        memcpy(sc->nx_prompt, prompt->v, (size_t)prompt->len * sizeof(int32_t));
+        sc->nx_len = (uint32_t)prompt->len;
+    }
+    if (!scope_tracing(sc)) return;
+    scope_record(sc, "PRMT", 4u + 4u * (uint32_t)prompt->len);
+    scope_put_u32(sc, (uint32_t)prompt->len);
+    scope_put(sc, prompt->v, (size_t)prompt->len * sizeof(int32_t));
+    scope_flush(sc);
+}
+
+/* The prompt the request feeds, from the server (ds4_session_scope_prompt): written whatever was written before (a
+ * reused live state can make it another token sequence than the request's own prompt, of any length). */
+static void scope_set_prompt(ds4_scope *sc, const ds4_tokens *prompt) {
+    if (!sc || sc->decoding) return;
+    sc->prompt_written = false;
+    scope_write_prompt(sc, prompt);
+}
+
+/* The residual sums (RSUM), at the request's end: every forward's batch has
+ * completed, so the sums are read straight from their shared buffers. */
+static void scope_write_rsum(ds4_scope *sc) {
+    const uint32_t L = sc->n_layer, W = DS4_N_HC * DS4_N_EMBD;
+    const float *sum = ds4_gpu_tensor_contents(sc->rsum), *last = ds4_gpu_tensor_contents(sc->rsum_last);
+    const uint64_t bytes = 12u + 4u * (uint64_t)L + 8u * (uint64_t)L * W;
+    if (!sum || !last || bytes > UINT32_MAX) {
+        scope_fail(sc, "residual sums are not host-visible");
+        return;
+    }
+    scope_record(sc, "RSUM", (uint32_t)bytes);
+    scope_put_u32(sc, L);
+    scope_put_u32(sc, W);
+    scope_put_u32(sc, sc->rsum_sink);
+    scope_put(sc, sc->rsum_n, (size_t)L * sizeof(uint32_t));
+    scope_put(sc, sum, (size_t)L * W * sizeof(float));
+    scope_put(sc, last, (size_t)L * W * sizeof(float));
+    scope_flush(sc);
+}
+
+/* After a traced forward's batch completed: one STEP record from the staging
+ * (see above), for its first keep rows (an MTP verify keeps the accepted
+ * ones; else keep = T).  logits: the host output logits of the forward's
+ * head-read rows (its last head_rows, one after another), or NULL. */
+static void scope_emit_forward(ds4_scope *sc, const int *tokens, uint32_t T, uint32_t pos0, const float *logits,
+                               uint32_t keep) {
+    if (!scope_tracing(sc) || T == 0) return;
+    if (T > sc->cap) {
+        scope_fail(sc, "forward wider than the staging");
+        return;
+    }
+    if (keep == 0 || keep > T) keep = T;
+    const uint32_t L = sc->n_layer, k = DS4_N_EXPERT_USED, hc = DS4_N_HC, E = DS4_N_EMBD, V = DS4_N_VOCAB;
+    const uint32_t K = sc->topk, nl = sc->n_lens, nj = scope_nj(sc);
+    /* The head read rows T - HR .. T - 1; of those, the kept ones. */
+    const uint32_t HR = sc->staged_head ? sc->head_rows : 0u, first = T - HR;
+    const uint32_t R = keep > first ? keep - first : 0u;
+    const bool head = R > 0, lens = head && nl > 0, out = head && logits != NULL && sc->staged_output;
+    const bool jl = head && nj > 0, lids = out && sc->n_ids > 0;
+    const uint32_t flags = (out ? 1u : 0u) | (lens ? 2u : 0u) | (head ? 4u : 0u) | (jl ? 16u : 0u) | (lids ? 64u : 0u);
+    uint64_t bytes = 16u + 4u * (uint64_t)keep + 8u * (uint64_t)L * keep * k + 8u * (uint64_t)L * keep * hc;
+    if (head) bytes += 4u * (uint64_t)R * L;
+    if (lens) bytes += 8u * (uint64_t)R * nl * K;
+    if (jl) bytes += 8u * (uint64_t)R * nj * K;
+    if (out) bytes += (uint64_t)R * (8u * K + 4u);
+    if (lids) bytes += 4u * (uint64_t)R * sc->n_ids;
+    if (bytes > UINT32_MAX) {
+        scope_fail(sc, "record too large");
+        return;
+    }
+    /* Every check before the record starts: a record cut short would throw
+     * the reader off for the rest of the file. */
+    const float *stats = ds4_gpu_tensor_contents(sc->stats);
+    const uint8_t *sel = ds4_gpu_tensor_contents(sc->sel), *w = ds4_gpu_tensor_contents(sc->w);
+    const float *sumsq = ds4_gpu_tensor_contents(sc->sumsq), *wsumsq = ds4_gpu_tensor_contents(sc->wsumsq);
+    const float *mixed = ds4_gpu_tensor_contents(sc->mixed), *lens_logits = ds4_gpu_tensor_contents(sc->lens_logits);
+    if (!sel || !w || !sumsq || !wsumsq || !stats || !mixed || !lens_logits) {
+        scope_fail(sc, "staging is not host-visible");
+        return;
+    }
+    scope_record(sc, "STEP", (uint32_t)bytes);
+    const uint32_t hdr[] = {pos0, keep, flags, R};
+    scope_put(sc, hdr, sizeof(hdr));
+    scope_put(sc, tokens, (size_t)keep * sizeof(int32_t));
+    /* the staging is [L][cap][..]: one layer's rows at a time */
+    for (uint32_t il = 0; il < L; il++) scope_put(sc, sel + (uint64_t)il * sc->cap * k * 4u, (size_t)keep * k * 4u);
+    for (uint32_t il = 0; il < L; il++) scope_put(sc, w + (uint64_t)il * sc->cap * k * 4u, (size_t)keep * k * 4u);
+    /* the stream norms, then what each layer changed in each stream */
+    float *norm = scope_host(sc, (size_t)keep * hc * sizeof(float));
+    const float *squares[] = {sumsq, wsumsq};
+    for (uint32_t s = 0; s < 2u; s++) {
+        for (uint32_t il = 0; il < L; il++) {
+            const float *src = squares[s] + (uint64_t)il * sc->cap * hc;
+            for (uint64_t i = 0; i < (uint64_t)keep * hc; i++) norm[i] = sqrtf(src[i]);
+            scope_put(sc, norm, (size_t)keep * hc * sizeof(float));
+        }
+    }
+    if (head) {
+        /* mixed: [L][HR][n_embd], fetched above */
+        float *rn = scope_host(sc, (size_t)R * L * sizeof(float));
+        for (uint32_t r = 0; r < R; r++) {
+            for (uint32_t il = 0; il < L; il++) {
+                double s = 0.0;
+                const float *row = mixed + ((uint64_t)il * HR + r) * E;
+                for (uint32_t i = 0; i < E; i++) s += (double)row[i] * row[i];
+                rn[(uint64_t)r * L + il] = (float)sqrt(s);
+            }
+        }
+        scope_put(sc, rn, (size_t)R * L * sizeof(float));
+    }
+    if (lens) {
+        /* the lens rows are [HR][n_lens]; the kept rows are the first R of HR */
+        const size_t rows = (size_t)R * nl, per = rows * K;
+        uint8_t *buf = scope_host(sc, per * 8u);
+        int32_t *ids = (int32_t *)buf;
+        float *logp = (float *)(buf + per * 4u);
+        scope_dist_rows(lens_logits, (uint32_t)rows, V, K, stats, ids, logp);
+        scope_put(sc, ids, per * 4u);
+        scope_put(sc, logp, per * 4u);
+    }
+    if (jl) {
+        /* the J-lens rows follow the logit lens's HR * n_lens: [HR][nj], the kept ones the first R */
+        const size_t rows = (size_t)R * nj, per = rows * K;
+        const uint64_t at = (uint64_t)HR * nl;
+        uint8_t *buf = scope_host(sc, per * 8u);
+        int32_t *ids = (int32_t *)buf;
+        float *logp = (float *)(buf + per * 4u);
+        scope_dist_rows(lens_logits + at * V, (uint32_t)rows, V, K, stats + 3u * at, ids, logp);
+        scope_put(sc, ids, per * 4u);
+        scope_put(sc, logp, per * 4u);
+    }
+    if (out) {
+        int32_t ids[DS4_SCOPE_HEAD_ROWS][DS4_SCOPE_MAX_TOPK];
+        float logp[DS4_SCOPE_HEAD_ROWS][DS4_SCOPE_MAX_TOPK], ent[DS4_SCOPE_HEAD_ROWS];
+        const uint64_t at = scope_out_stats_row(sc, HR);
+        for (uint32_t r = 0; r < R; r++)
+            scope_dist_row(logits + (uint64_t)r * V, V, K, stats + 3u * (at + r), ids[r], logp[r], &ent[r]);
+        for (uint32_t r = 0; r < R; r++) scope_put(sc, ids[r], K * 4u);
+        for (uint32_t r = 0; r < R; r++) scope_put(sc, logp[r], K * 4u);
+        scope_put(sc, ent, R * 4u);
+    }
+    if (lids) {
+        /* the same rows at the LIDS ids, from the same statistics as their top-k */
+        const uint64_t at = scope_out_stats_row(sc, HR);
+        const uint32_t n = sc->n_ids;
+        float *lp = scope_host(sc, (size_t)R * n * sizeof(float));
+        for (uint32_t r = 0; r < R; r++) {
+            const float lse = scope_lse(stats + 3u * (at + r));
+            for (uint32_t j = 0; j < n; j++) lp[(uint64_t)r * n + j] = logits[(uint64_t)r * V + sc->ids[j]] - lse;
+        }
+        scope_put(sc, lp, (size_t)R * n * sizeof(float));
+    }
+    scope_flush(sc);
+    sc->staged_head = sc->staged_output = false;
+}
+
+/* The pieces each graph calls inside a forward's batch, for traced layer il:
+ * steer its residual R (T rows of n_hc * n_embd floats: the layer's removal,
+ * then its vector, on the steered rows), stage its routing
+ * (selected/weights: T rows of k from row0 of the forward), its rows' stream
+ * norms, and the forward's last row whole (the last of R when last). */
+static bool scope_steer(ds4_scope *sc, uint32_t il, ds4_gpu_tensor *R, uint32_t T, uint32_t pos0,
+                        uint32_t *steered) {
+    const uint32_t n = scope_steer_rows(sc, il, pos0, T);
+    if (steered) *steered = n;
+    if (!n) return true;
+#ifdef __APPLE__
+    const uint32_t W = DS4_N_HC * DS4_N_EMBD;
+    const uint64_t row = (uint64_t)W * sizeof(float);
+    ds4_gpu_tensor *tail = n == T ? R : ds4_gpu_tensor_view(R, (uint64_t)(T - n) * row, (uint64_t)n * row);
+    const bool ok = tail &&
+        (!sc->rem_n[il] || ds4_gpu_scope_remove_rows_tensor(tail, sc->rem_q, sc->rem_row[il], sc->rem_n[il], W, n)) &&
+        (!sc->steer_layer[il] || ds4_gpu_scope_add_rows_tensor(tail, sc->steer_vec, il, W, n));
+    if (tail != R) ds4_gpu_tensor_free(tail);
+    return ok;
+#else
+    (void)R;
+    return true;
+#endif
+}
+
+static bool scope_router(ds4_scope *sc, uint32_t il, uint32_t row0, uint32_t T,
+                         const ds4_gpu_tensor *selected, const ds4_gpu_tensor *weights) {
+    if (!scope_tracing(sc) || il >= sc->n_layer || row0 + T > sc->cap) return true;
+    const uint64_t kb = (uint64_t)DS4_N_EXPERT_USED * 4u, at = ((uint64_t)il * sc->cap + row0) * kb;
+    return ds4_gpu_tensor_copy(sc->sel, at, selected, 0, T * kb) &&
+           ds4_gpu_tensor_copy(sc->w, at, weights, 0, T * kb);
+}
+
+/* Residual sums: R's rows (positions pos0 ..) from the sink to the prompt's
+ * end added into layer il's sum, each position once (a replay of positions
+ * already added adds nothing), and the prompt's last row copied.  The sink
+ * is at most the prompt's last position, as oMLX's residual_samples. */
+static bool scope_rsum(ds4_scope *sc, uint32_t il, const ds4_gpu_tensor *R, uint32_t T, uint32_t pos0) {
+#ifdef __APPLE__
+    const uint32_t P = sc->prompt_len, W = DS4_N_HC * DS4_N_EMBD;
+    if (!sc->rsum_on || !P || il >= sc->n_layer) return true;
+    const uint32_t sink = sc->rsum_sink < P ? sc->rsum_sink : P - 1u;
+    uint32_t from = pos0 > sink ? pos0 : sink;
+    if (from < sc->rsum_next[il]) from = sc->rsum_next[il];
+    const uint32_t end = pos0 + T < P ? pos0 + T : P;
+    if (from >= end) return true;
+    sc->rsum_n[il] += end - from;
+    sc->rsum_next[il] = end;
+    return ds4_gpu_scope_rows_accum_tensor(R, W, from - pos0, end - from, sc->rsum, il * W) &&
+           (end != P || ds4_gpu_tensor_copy(sc->rsum_last, (uint64_t)il * W * 4u, R,
+                                            (uint64_t)(P - 1u - pos0) * W * 4u, (uint64_t)W * 4u));
+#else
+    (void)sc; (void)il; (void)R; (void)T; (void)pos0;
+    return true;
+#endif
+}
+
+/* before: room for the streams a traced layer reads, for a forward of rows
+ * rows (at least DS4_SCOPE_HEAD_ROWS).  Called before the forward's first use
+ * of before, every earlier batch complete (each traced forward ends its own):
+ * grown to the rows, and given back to DS4_SCOPE_HEAD_ROWS by the first narrow
+ * forward after a wide one (decode after a long prompt, whose chunks' rows
+ * hold hundreds of MB here). */
+static void scope_before_fit(ds4_scope *sc, uint32_t rows) {
+    if (!scope_tracing(sc)) return;
+    const uint32_t want = rows > DS4_SCOPE_HEAD_ROWS ? rows : DS4_SCOPE_HEAD_ROWS;
+    if (sc->before && want <= sc->before_rows && (want > DS4_SCOPE_HEAD_ROWS || sc->before_rows == want)) return;
+    ds4_gpu_tensor_free(sc->before);
+    sc->before = ds4_gpu_tensor_alloc((uint64_t)want * DS4_N_HC * DS4_N_EMBD * sizeof(float));
+    sc->before_rows = sc->before ? want : 0u;
+    if (!sc->before) scope_fail(sc, "staging allocation failed");
+}
+
+/* The streams a forward's first traced layer reads (R's first T rows: the
+ * embedding's, or a V4.1 prefill chunk's rows as the layer reads them), into
+ * before, inside the forward's batch and before anything else of it uses
+ * before (a V4.1 sweep's first chunk grows it here: the sweep's earlier
+ * batches are complete). */
+static bool scope_streams_in(ds4_scope *sc, const ds4_gpu_tensor *R, uint32_t T) {
+#ifdef __APPLE__
+    if (!scope_tracing(sc)) return true;
+    if (T > sc->before_rows) scope_before_fit(sc, T);
+    if (!scope_tracing(sc)) return true;          /* its allocation failed */
+    return ds4_gpu_tensor_copy(sc->before, 0, R, 0, (uint64_t)T * DS4_N_HC * DS4_N_EMBD * sizeof(float)) != 0;
+#else
+    (void)sc; (void)R; (void)T;
+    return true;
+#endif
+}
+
+/* Stream norms of R's T rows (at row0 of the forward, positions pos0 ..) and
+ * what the layer changed in each stream (R less before, which then holds R for
+ * the next layer), their residual sums, and its last nhead rows whole for the
+ * head stage (0: none; this layer's slot of res). */
+static bool scope_resid(ds4_scope *sc, uint32_t il, uint32_t row0, ds4_gpu_tensor *R, uint32_t T, uint32_t pos0,
+                        uint32_t nhead) {
+#ifdef __APPLE__
+    const uint32_t hc = DS4_N_HC, E = DS4_N_EMBD, row = hc * E;
+    if (!scope_tracing(sc) || il >= sc->n_layer || row0 + T > sc->cap) return true;
+    if (nhead > DS4_SCOPE_HEAD_ROWS || nhead > T) {
+        scope_fail(sc, "more head rows than the staging holds");
+        return true;
+    }
+    if (T > sc->before_rows) {
+        scope_fail(sc, "forward wider than the staging");
+        return true;
+    }
+    if (nhead) sc->head_rows = nhead;
+    return ds4_gpu_scope_rows_sumsq_tensor(R, sc->sumsq, sc->before, sc->wsumsq, E, T * hc,
+                                           (il * sc->cap + row0) * hc) &&
+           scope_rsum(sc, il, R, T, pos0) &&
+           (!nhead || ds4_gpu_tensor_copy(sc->res, (uint64_t)il * nhead * row * 4u, R,
+                                          (uint64_t)(T - nhead) * row * 4u, (uint64_t)nhead * row * 4u));
+#else
+    (void)sc; (void)il; (void)row0; (void)R; (void)T; (void)pos0; (void)nhead;
+    return true;
+#endif
+}
+
+/* Qwen3.8: all of it at the end of the layer (its router buffers stay put). */
+static bool scope_layer(ds4_scope *sc, uint32_t il, ds4_gpu_tensor *R, uint32_t T, uint32_t pos0, uint32_t nhead,
+                        const ds4_gpu_tensor *selected, const ds4_gpu_tensor *weights) {
+    return scope_steer(sc, il, R, T, pos0, NULL) && scope_router(sc, il, 0, T, selected, weights) &&
+           scope_resid(sc, il, 0, R, T, pos0, nhead);
+}
+
+/* A forward whose record waits: for its output head (V4.1), or for the
+ * verdict on its drafts (an MTP verify). */
+static void scope_set_pending(ds4_scope *sc, const int *tokens, uint32_t T, uint32_t pos0) {
+    if (!scope_tracing(sc) || T == 0) return;
+    if (T > sc->cap) {
+        scope_fail(sc, "forward wider than the staging");
+        return;
+    }
+    memcpy(sc->pending_tokens, tokens, (size_t)T * sizeof(int32_t));
+    sc->pending_T = T;
+    sc->pending_pos = pos0;
+    sc->pending = true;
+}
+
+/* Write the waiting record, its first keep rows (0: all): with the head's
+ * reads and the outputs when the head stage ran for it (logits), else
+ * without. */
+static void scope_flush_pending(ds4_scope *sc, const float *logits, uint32_t keep) {
+    if (!sc || !sc->pending) return;
+    sc->pending = false;
+    if (!logits) sc->staged_head = sc->staged_output = false;
+    scope_emit_forward(sc, sc->pending_tokens, sc->pending_T, sc->pending_pos, logits, keep);
+}
+
+#endif /* DS4_NO_GPU */
diff --git a/ds4_scope_ds41.inc b/ds4_scope_ds41.inc
new file mode 100644
index 0000000..ae49fd1
--- /dev/null
+++ b/ds4_scope_ds41.inc
@@ -0,0 +1,122 @@
+/* metalscope's DeepSeek V4.1 graph hooks (ds4_scope.inc), included by ds4.c
+ * after ds41_moe. */
+
+/* ds4.c defines it below the head stage's call (a prototype that stops matching does not compile). */
+static bool ds41_norm_batch(ds4_gpu_tensor *out, const ds4_gpu_tensor *in,
+                            const ds4_model *m, const ds4_tensor *weight, uint32_t count);
+
+/* metalscope head stage for the waiting forward, inside the output head's
+ * batch: every layer's staged last row collapsed as the head collapses the
+ * last layer's (hc_sum with that layer's pre weights), the lens layers' rows
+ * through the output norm and LM head, and the softmax statistics of those
+ * logits and of the output row. */
+static bool ds41_scope_head(ds41_gpu_graph *g, const ds4_model *m, const ds4_weights *w) {
+#ifdef __APPLE__
+    ds4_scope *sc = g->scope;
+    const uint32_t L = sc->n_layer, E = DS4_N_EMBD, V = DS4_N_VOCAB, nl = sc->n_lens;
+    if (sc->head_rows != 1u) return true;      /* V4.1 reads one row per forward; nothing staged */
+    /* The weighted sum takes its row count from the output's size: exact views. */
+    ds4_gpu_tensor *mixed = ds4_gpu_tensor_view(sc->mixed, 0, (uint64_t)L * E * 4u);
+    ds4_gpu_tensor *res = ds4_gpu_tensor_view(sc->res, 0, (uint64_t)L * DS4_N_HC * E * 4u);
+    ds4_gpu_tensor *pre = ds4_gpu_tensor_view(sc->pre, 0, (uint64_t)L * DS4_N_HC * 4u);
+    bool ok = mixed && res && pre &&
+              ds4_gpu_scope_row_stats_tensor(g->logits, sc->stats, V, 1, scope_out_stats_row(sc, 1)) &&
+              ds4_gpu_hc_weighted_sum_tensor(mixed, res, pre, E, DS4_N_HC) &&
+              ds41_bf16(sc->mixed, L * E);
+    ds4_gpu_tensor_free(mixed);
+    ds4_gpu_tensor_free(res);
+    ds4_gpu_tensor_free(pre);
+    for (uint32_t j = 0; ok && j < nl; j++) {
+        ok = ds4_gpu_tensor_copy(sc->lens_in, (uint64_t)j * E * 4u, sc->mixed, (uint64_t)sc->lens[j] * E * 4u,
+                                 (uint64_t)E * 4u) != 0;
+    }
+    if (ok && nl) {
+        ok = ds41_norm_batch(sc->lens_x, sc->lens_in, m, w->output_norm, nl) &&
+             ds41_output_projection(g, sc->lens_logits, m, w, sc->lens_x, nl) &&
+             ds4_gpu_scope_row_stats_tensor(sc->lens_logits, sc->stats, V, nl, 0);
+    }
+    sc->staged_head = sc->staged_output = ok;
+    return ok;
+#else
+    (void)g; (void)m; (void)w;
+    return true;
+#endif
+}
+
+/* A decode forward, after the embedding and inside its batch: the streams
+ * layer 0 reads (staging for its one row). */
+static bool ds41_scope_step_in(ds41_gpu_graph *g) {
+    scope_before_fit(g->scope, 1);
+    return scope_streams_in(g->scope, g->residual, 1);
+}
+
+/* After decode layer il: steer the layer's output (then keep the residual's
+ * BF16 rounding), stage its stream norms and what it changed in them, its row
+ * and collapse weights. */
+static bool ds41_scope_layer(ds41_gpu_graph *g, uint32_t il) {
+    ds4_scope *sc = g->scope;
+    uint32_t steered = 0;
+    bool ok = scope_steer(sc, il, g->residual, 1, g->pos, &steered) &&
+              (!steered || ds41_bf16(g->residual, DS4_N_HC * DS4_N_EMBD));
+    if (ok && scope_tracing(sc) && il < sc->n_layer)
+        ok = scope_resid(sc, il, 0, g->residual, 1, g->pos, 1) &&
+             ds4_gpu_tensor_copy(sc->pre, (uint64_t)il * DS4_N_HC * 4u, g->pre, 0, DS4_N_HC * 4u);
+    return ok;
+}
+
+/* A prefill sweep starts: write the waiting record, then start the sweep's
+ * rows empty (a long prompt's deep layers run on a suffix only).  The hooks
+ * sit on the batched path (batch_hc, as the sweep decides it): when it would
+ * run per row, false, and the scoped request fails rather than lose its
+ * steering, its lookup setting and its records on the prompt rows. */
+static bool ds41_scope_sweep_begin(ds4_scope *sc, uint32_t total_count, bool batch_hc) {
+    scope_flush_pending(sc, NULL, 0);
+    if (!batch_hc) {
+        scope_fail(sc, "V4.1's batched prefill is off (a DS4_METAL_DISABLE_V41_BATCH_* variable is set), and "
+                       "metalscope hooks only that path: the request fails");
+        return false;
+    }
+    if (scope_tracing(sc)) scope_clear_rows(sc, total_count);
+    return true;
+}
+
+/* After layer il of a batched sweep, rows off .. off + count - 1 (positions
+ * start ..): steer them (keeping the BF16 rounding), stage their routing,
+ * stream norms and what the layer changed in them, and at the sweep's last row
+ * the row and its collapse weights (the row's own view of the split, where the
+ * sweep itself takes them). */
+static bool ds41_scope_rows(ds41_gpu_graph *g, ds41_prefill_row *active, uint32_t il, uint32_t off,
+                            uint32_t count, uint32_t start, bool last) {
+    ds4_scope *sc = g->scope;
+    uint32_t steered = 0;
+    bool ok = scope_steer(sc, il, active->residual, count, start, &steered) &&
+              (!steered || ds4_gpu_dsv41_quantize(active->residual, DS4_N_EMBD * DS4_N_HC, count, DS4_V41_BF16));
+    if (ok) ok = scope_router(sc, il, off, count, g->batch.selected, g->batch.route_weights) &&
+                 scope_resid(sc, il, off, active->residual, count, start, last ? 1u : 0u);
+    if (ok && last && scope_tracing(sc) && il < sc->n_layer)
+        ok = ds4_gpu_tensor_copy(sc->pre, (uint64_t)il * DS4_N_HC * 4u, g->rows_view[count - 1u].ffn_split, 0,
+                                 DS4_N_HC * 4u) != 0;
+    return ok;
+}
+
+/* Scope next_lp on V4.1: its sweep reads no row's output head, so a sync feeds
+ * the rows from nx_from - 1 on one at a time, each through the forward's own
+ * head (ds41_scope_next_lp); UINT32_MAX: none. */
+static uint32_t ds41_scope_nx_row(const ds41_gpu_graph *g) {
+    const ds4_scope *sc = g->scope;
+    return sc && scope_tracing(sc) && sc->nx_from && sc->nx_prompt ? sc->nx_from - 1u : UINT32_MAX;
+}
+
+/* NXLP and NXTK for prompt row pos from its logits z (the sync's forward of that
+ * row alone): the prompt's next token's log-probability and the top choices. */
+static void ds41_scope_next_lp(ds4_scope *sc, const float *z, uint32_t pos) {
+    if (!scope_tracing(sc) || !sc->nx_prompt || pos + 1u >= sc->nx_len) return;
+    const uint32_t V = DS4_N_VOCAB, next = (uint32_t)sc->nx_prompt[pos + 1u];
+    float st[3] = {-FLT_MAX, 0.0f, 0.0f}, top_lp[DS4_SCOPE_NX_TOP];
+    int32_t top_ids[DS4_SCOPE_NX_TOP];
+    for (uint32_t i = 0; i < V; i++) if (z[i] > st[0]) st[0] = z[i];
+    for (uint32_t i = 0; i < V; i++) st[1] += expf(z[i] - st[0]);
+    const float lp = next < V ? z[next] - scope_lse(st) : -FLT_MAX;
+    scope_dist_row(z, V, DS4_SCOPE_NX_TOP, st, top_ids, top_lp, NULL);
+    scope_put_next_lp(sc, pos, 1u, DS4_SCOPE_NX_TOP, &lp, top_ids, top_lp);
+}
diff --git a/ds4_scope_qwen4.inc b/ds4_scope_qwen4.inc
new file mode 100644
index 0000000..319e77e
--- /dev/null
+++ b/ds4_scope_qwen4.inc
@@ -0,0 +1,149 @@
+/* metalscope's Qwen3.8 graph hooks (ds4_scope.inc), included by ds4.c
+ * before qwen4_graph_attention_tail. */
+
+/* A forward of T rows starts: a verify whose record still waits (no
+ * verdict came) is written without its head reads before this forward reuses
+ * the staging, which is sized for its rows.  The head reads the last row, or
+ * every row of a verify (all_rows): returns how many. */
+static uint32_t qwen4_scope_begin(ds4_scope *sc, uint32_t T, bool all_rows) {
+    scope_flush_pending(sc, NULL, 0);
+    scope_before_fit(sc, T);
+    return all_rows ? T : 1u;
+}
+
+/* metalscope head stage, after the output head and before the batch ends:
+ * the staged head rows (HR: the forward's last row, or all of an MTP
+ * verify's) of every trunk layer through the final mixer (what the head
+ * reads), the lens layers' rows through the LM head, and the softmax
+ * statistics of those logits and of the output rows (the first HR rows of
+ * g->logits, when output).  g->R points at the staging for the mixer;
+ * g->mixed's own rows are put back afterwards, since the MTP drafter reads
+ * them. */
+static bool qwen4_scope_head(ds4_qwen4_gpu_graph *g, const ds4_model *m, const ds4_weights *w, bool output) {
+#ifdef __APPLE__
+    ds4_scope *sc = g->scope;
+    const uint32_t L = sc->n_layer, E = DS4_N_EMBD, V = DS4_N_VOCAB, nl = sc->n_lens, HR = sc->head_rows;
+    const uint64_t row = (uint64_t)DS4_N_HC * E * 4u;
+    if (HR == 0) return true;
+    if ((uint64_t)L * HR > g->cap_tokens) {
+        char what[128];
+        snprintf(what, sizeof(what), "the head reads need a prefill chunk of %u rows or more (--prefill-chunk)",
+                 L * HR);
+        scope_fail(sc, what);
+        return true;
+    }
+    const uint32_t nj = scope_nj(sc), W = DS4_N_HC * E;
+    bool ok = ds4_gpu_tensor_copy(sc->mixed_save, 0, g->mixed, 0, (uint64_t)HR * E * 4u) != 0;
+    if (ok && output) {
+        ds4_gpu_tensor *rows = ds4_gpu_tensor_view(g->logits, 0, (uint64_t)HR * V * 4u);
+        ok = rows && ds4_gpu_scope_row_stats_tensor(rows, sc->stats, V, HR, scope_out_stats_row(sc, HR));
+        ds4_gpu_tensor_free(rows);
+    }
+    /* J-lens rows [HR][nj] after the logit lens's [HR][n_lens]: J [n_embd][n_hc * n_embd] times the layer's
+     * staged streams (S, not the mixer's output: the lens was fitted on S), straight into the head's input. */
+    for (uint32_t j = 0; ok && j < nj; j++) {
+        ds4_gpu_tensor *x = ds4_gpu_tensor_view(sc->res, (uint64_t)sc->jlens[j] * HR * row, (uint64_t)HR * row);
+        ok = x && ds4_gpu_scope_project_tensor(x, W, sc->jlens_w, j * E, W, E, HR, sc->lens_in,
+                                               ((uint32_t)HR * nl + j) * E, nj * E);
+        ds4_gpu_tensor_free(x);
+    }
+    ds4_gpu_tensor *R_save = g->R, *staged = ds4_gpu_tensor_view(sc->res, 0, (uint64_t)L * HR * row);
+    g->R = staged;
+    ok = ok && staged && qwen4_graph_hc_mix(g, m, w->output_hc_norm, w->output_hc_down, w->output_hc_up, NULL, L * HR);
+    g->R = R_save;
+    ds4_gpu_tensor_free(staged);
+    ok = ok && ds4_gpu_tensor_copy(sc->mixed, 0, g->mixed, 0, (uint64_t)L * HR * E * 4u);
+    /* lens rows [HR][n_lens]: row r of lens layer j is mixed row lens[j] * HR + r */
+    for (uint32_t r = 0; ok && r < HR; r++) {
+        for (uint32_t j = 0; ok && j < nl; j++) {
+            ok = ds4_gpu_tensor_copy(sc->lens_in, ((uint64_t)r * nl + j) * E * 4u, g->mixed,
+                                     ((uint64_t)sc->lens[j] * HR + r) * E * 4u, (uint64_t)E * 4u) != 0;
+        }
+    }
+    /* the head in tiles of up to 32 rows (each view spans a whole tile: the
+     * batched kernel computes all of it, the rows past n as scratch) */
+    const uint32_t n = (nl + nj) * HR;
+    for (uint32_t o = 0; ok && o < n; o += 32u) {
+        const uint32_t cnt = n - o < 32u ? n - o : 32u;
+        ds4_gpu_tensor *x = ds4_gpu_tensor_view(sc->lens_in, (uint64_t)o * E * 4u, 32u * (uint64_t)E * 4u);
+        ds4_gpu_tensor *y = ds4_gpu_tensor_view(sc->lens_logits, (uint64_t)o * V * 4u, 32u * (uint64_t)V * 4u);
+        ok = x && y && qwen4_gemv(y, m, w->output, x, cnt);
+        ds4_gpu_tensor_free(x);
+        ds4_gpu_tensor_free(y);
+    }
+    if (ok && n) ok = ds4_gpu_scope_row_stats_tensor(sc->lens_logits, sc->stats, V, n, 0);
+    ok = ok && ds4_gpu_tensor_copy(g->mixed, 0, sc->mixed_save, 0, (uint64_t)HR * E * 4u);
+    sc->staged_head = ok;
+    sc->staged_output = ok && output;
+    return ok;
+#else
+    (void)g; (void)m; (void)w; (void)output;
+    return true;
+#endif
+}
+
+/* NXLP (scope next_lp), after the trunk and before the graph's own head (which
+ * then redoes g->mixed): the forward's rows from nx_from - 1 on whose next
+ * token the prompt holds, through the final mixer and LM head in tiles, each
+ * in its own batch, and each row's log-probability of that token and its top
+ * DS4_SCOPE_NX_TOP (NXTK), from the same logits and statistics. */
+static bool qwen4_scope_next_lp(ds4_qwen4_gpu_graph *g, const ds4_model *m, const ds4_weights *w,
+                                uint32_t pos0, uint32_t T) {
+#ifdef __APPLE__
+    ds4_scope *sc = g->scope;
+    if (!scope_tracing(sc) || !sc->nx_from || !sc->nx_prompt) return true;
+    const uint32_t V = DS4_N_VOCAB, row = DS4_N_HC * DS4_N_EMBD * 4u, tile = DS4_SCOPE_NX_TILE;
+    const uint32_t lo = sc->nx_from - 1u > pos0 ? sc->nx_from - 1u - pos0 : 0u;
+    const uint32_t hi = pos0 + T < sc->nx_len ? T : sc->nx_len > pos0 + 1u ? sc->nx_len - pos0 - 1u : 0u;
+    if (lo >= hi) return true;
+    if (!sc->nx_logits) sc->nx_logits = ds4_gpu_tensor_alloc((uint64_t)tile * V * 4u);
+    if (!sc->nx_stats) sc->nx_stats = ds4_gpu_tensor_alloc((uint64_t)tile * 3u * 4u);
+    const uint32_t K = DS4_SCOPE_NX_TOP;
+    float *lp = xmalloc((size_t)(hi - lo) * sizeof(float));
+    int32_t *top_ids = xmalloc((size_t)(hi - lo) * K * sizeof(int32_t));
+    float *top_lp = xmalloc((size_t)(hi - lo) * K * sizeof(float));
+    ds4_gpu_tensor *R = g->R;
+    /* the trunk's batch ends here: its failure is the forward's, not only the trace's */
+    bool ok = sc->nx_logits && sc->nx_stats, flushed = true;
+    if (ok) ok = flushed = ds4_gpu_end_commands() != 0;
+    for (uint32_t o = lo; ok && o < hi; o += tile) {
+        const uint32_t n = hi - o < tile ? hi - o : tile;
+        ds4_gpu_tensor *rows = ds4_gpu_tensor_view(R, (uint64_t)o * row, (uint64_t)n * row);
+        g->R = rows;
+        ok = rows && ds4_gpu_begin_commands() &&
+             qwen4_graph_hc_mix(g, m, w->output_hc_norm, w->output_hc_down, w->output_hc_up, NULL, n) &&
+             qwen4_gemv(sc->nx_logits, m, w->output, g->mixed, n) &&
+             ds4_gpu_scope_row_stats_tensor(sc->nx_logits, sc->nx_stats, V, n, 0);
+        g->R = R;
+        ds4_gpu_tensor_free(rows);
+        if (ds4_gpu_commands_active() && !ds4_gpu_end_commands()) ok = flushed = false;
+        const float *z = ds4_gpu_tensor_contents(sc->nx_logits), *st = ds4_gpu_tensor_contents(sc->nx_stats);
+        ok = ok && z && st;
+        for (uint32_t r = 0; ok && r < n; r++) {
+            const float *s = st + 3u * r;
+            const uint32_t next = (uint32_t)sc->nx_prompt[pos0 + o + r + 1u];
+            lp[o - lo + r] = next < V ? z[(uint64_t)r * V + next] - scope_lse(s) : -FLT_MAX;
+        }
+        if (ok) scope_dist_rows(z, n, V, K, st, top_ids + (uint64_t)(o - lo) * K, top_lp + (uint64_t)(o - lo) * K);
+    }
+    if (ok) scope_put_next_lp(sc, pos0 + lo, hi - lo, K, lp, top_ids, top_lp);
+    else scope_fail(sc, "next-token log-probabilities failed");
+    free(lp);
+    free(top_ids);
+    free(top_lp);
+    const bool begun = glm_graph_begin_commands_if_needed();
+    return flushed && begun;
+#else
+    (void)g; (void)m; (void)w; (void)pos0; (void)T;
+    return true;
+#endif
+}
+
+/* The forward's batch has completed: its record, or for a verify the record
+ * waits for the verdict on its drafts (ds4_session_qwen4_spec_cycle keeps the
+ * accepted rows). */
+static void qwen4_scope_end(ds4_scope *sc, const int *tokens, uint32_t T, uint32_t pos0, const float *logits,
+                            bool all_rows) {
+    if (all_rows && T > 1u) scope_set_pending(sc, tokens, T, pos0);
+    else scope_emit_forward(sc, tokens, T, pos0, logits, T);
+}
diff --git a/ds4_scope_session.inc b/ds4_scope_session.inc
new file mode 100644
index 0000000..a5782a4
--- /dev/null
+++ b/ds4_scope_session.inc
@@ -0,0 +1,531 @@
+/* metalscope's session API (ds4_scope.h) and the session paths' hooks,
+ * included by ds4.c after ds4_session_invalidate; the capture itself is
+ * ds4_scope.inc. */
+
+/* The server hands over resolved paths inside its scope directory (no
+ * symlinks left): opening refuses a symlink anywhere in the path, so a
+ * directory swapped for one after the check is not followed (macOS; elsewhere
+ * the last component only). */
+#ifndef O_NOFOLLOW_ANY
+#define O_NOFOLLOW_ANY O_NOFOLLOW
+#endif
+
+/* O_EXCL: the name must not exist, so nothing already there (another request's trace, a FIFO, a file a client named)
+ * is truncated or opened. (macOS refuses O_NOFOLLOW with O_NOFOLLOW_ANY.) */
+FILE *ds4_scope_trace_create(const char *path) {
+    const int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW_ANY | O_CLOEXEC, 0666);
+    FILE *fp = fd >= 0 ? fdopen(fd, "wb") : NULL;
+    if (!fp && fd >= 0) close(fd);
+    return fp;
+}
+
+#ifndef DS4_NO_GPU
+/* The graph that takes the scope, its family, traced layer count and the
+ * most rows one forward feeds; NULL for a model or setup metalscope does not
+ * hook. */
+static ds4_scope **scope_graph(ds4_session *s, uint32_t *family, uint32_t *n_layer, uint32_t *cap) {
+#if defined(__APPLE__) && defined(DS4_HAS_QWEN4_GPU)
+    if (ds4_session_is_qwen4(s) && s->qwen4_graph_ready) {
+        *family = DS4_SCOPE_FAMILY_QWEN4;
+        *n_layer = DS4_N_LAYER - DS4_N_NEXTN_PREDICT;
+        *cap = s->qwen4_graph.cap_tokens;
+        return &s->qwen4_graph.scope;
+    }
+#endif
+#if defined(__APPLE__) && defined(DS4_HAS_DEEPSEEK41_GPU)
+    /* The prefill hooks sit on the batched sweep: ds41_scope_sweep_begin fails a sweep that would run per row. */
+    if (ds4_session_is_ds41(s) && s->ds41_graph_ready && s->ds41_graph.tp_world == 1) {
+        const ds41_gpu_graph *g = &s->ds41_graph;
+        *family = DS4_SCOPE_FAMILY_DS41;
+        *n_layer = DS4_N_LAYER;
+        /* a layer-major prefill sweep holds up to carry_cap rows */
+        *cap = g->carry_cap > g->prefill_cap ? g->carry_cap : g->prefill_cap;
+        return &s->ds41_graph.scope;
+    }
+#endif
+    (void)s; (void)family; (void)n_layer; (void)cap;
+    return NULL;
+}
+
+static FILE *scope_open_read(const char *path) {
+    const int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW_ANY);
+    FILE *fp = fd >= 0 ? fdopen(fd, "rb") : NULL;
+    if (!fp && fd >= 0) close(fd);
+    return fp;
+}
+
+/* FNV-1a, 64 bits, continuing from h. */
+static uint64_t scope_fnv(uint64_t h, const void *p, size_t n) {
+    const uint8_t *b = p;
+    for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 0x100000001b3ull;
+    return h;
+}
+
+/* Steering file: "DS4STEER", u32 version (2), u32 n, u32 width (n_hc * n_embd),
+ * u32 n_remove, then n times u32 layer and f32 vector[width], already scaled
+ * (added to the whole residual row after that layer), then n_remove times
+ * u32 layer (each once), u32 k (1 .. DS4_SCOPE_MAX_REMOVE) and f32 directions[k][width],
+ * orthonormal: the row's part along them is taken out before the add.
+ * steer_sig: a signature of the entries as read (the session's rows are
+ * reused only under the same). */
+static bool scope_load_steering(ds4_scope *sc, const char *path, char *err, size_t errlen) {
+    const uint32_t width = DS4_N_HC * DS4_N_EMBD;
+    FILE *fp = scope_open_read(path);
+    if (!fp) {
+        snprintf(err, errlen, "cannot open steering file %s", path);
+        return false;
+    }
+    char magic[8];
+    uint32_t head[4];
+    bool ok = fread(magic, 1, 8, fp) == 8 && !memcmp(magic, "DS4STEER", 8) &&
+              fread(head, sizeof(head[0]), 4, fp) == 4 && head[0] == 2u && head[2] == width;
+    if (!ok) {
+        fclose(fp);
+        snprintf(err, errlen, "steering file %s: bad header (need version 2, width %u)", path, width);
+        return false;
+    }
+    const uint64_t floats = (uint64_t)sc->n_layer * width;
+    float *v = xcalloc(floats, sizeof(float)), *q = NULL;
+    uint32_t q_rows = 0;
+    memset(sc->steer_layer, 0, sizeof(sc->steer_layer));
+    memset(sc->rem_n, 0, sizeof(sc->rem_n));
+    uint64_t sig = scope_fnv(0xcbf29ce484222325ull, head, sizeof(head));
+    for (uint32_t i = 0; ok && i < head[1]; i++) {
+        uint32_t layer = 0;
+        ok = fread(&layer, sizeof(layer), 1, fp) == 1 && layer < sc->n_layer &&
+             fread(v + (uint64_t)layer * width, sizeof(float), width, fp) == width;
+        if (ok) {
+            sc->steer_layer[layer] = 1;
+            sig = scope_fnv(scope_fnv(sig, &layer, sizeof(layer)), v + (uint64_t)layer * width,
+                            (size_t)width * sizeof(float));
+        }
+    }
+    for (uint32_t i = 0; ok && i < head[3]; i++) {
+        uint32_t blk[2];
+        ok = fread(blk, sizeof(blk[0]), 2, fp) == 2 && blk[0] < sc->n_layer && !sc->rem_n[blk[0]] &&
+             blk[1] > 0 && blk[1] <= DS4_SCOPE_MAX_REMOVE;
+        if (!ok) break;
+        const size_t at = (size_t)q_rows * width, n = (size_t)blk[1] * width;
+        q = xrealloc(q, (at + n) * sizeof(float));
+        ok = fread(q + at, sizeof(float), n, fp) == n;
+        sc->rem_n[blk[0]] = (uint8_t)blk[1];
+        sc->rem_row[blk[0]] = q_rows;
+        q_rows += blk[1];
+        if (ok) sig = scope_fnv(scope_fnv(sig, blk, sizeof(blk)), q + at, n * sizeof(float));
+    }
+    fclose(fp);
+    if (ok && !sc->steer_vec) sc->steer_vec = ds4_gpu_tensor_alloc(floats * sizeof(float));
+    ok = ok && sc->steer_vec && ds4_gpu_tensor_write(sc->steer_vec, 0, v, floats * sizeof(float));
+    if (ok && q_rows > sc->rem_q_rows) {
+        ds4_gpu_tensor_free(sc->rem_q);
+        sc->rem_q = ds4_gpu_tensor_alloc((uint64_t)q_rows * width * sizeof(float));
+        sc->rem_q_rows = sc->rem_q ? q_rows : 0u;
+    }
+    ok = ok && (!q_rows || (sc->rem_q && ds4_gpu_tensor_write(sc->rem_q, 0, q, (uint64_t)q_rows * width * sizeof(float))));
+    free(v);
+    free(q);
+    if (!ok) {
+        snprintf(err, errlen, "steering file %s: truncated, a layer out of range or removed twice, over %u "
+                 "directions at a layer, or upload failed", path, DS4_SCOPE_MAX_REMOVE);
+        memset(sc->steer_layer, 0, sizeof(sc->steer_layer));
+        memset(sc->rem_n, 0, sizeof(sc->rem_n));
+        return false;
+    }
+    sc->steer_any = head[1] > 0 || head[3] > 0;
+    sc->steer_sig = sig ? sig : 1u;
+    return true;
+}
+
+/* J-lens file: "DS4JLENS", u32 version (1), u32 n, u32 in_width (n_hc * n_embd), u32 out_width (n_embd), then per
+ * layer (increasing) u32 layer, f16 J[out_width][in_width].  Read on every head row: J times the layer's streams,
+ * then the LM head, as oMLX reads Flash Next's J-lens.  ``n`` alone with peek (sizing the staging). */
+static bool scope_read_jlens_head(FILE *fp, uint32_t head[4]) {
+    char magic[8];
+    return fread(magic, 1, 8, fp) == 8 && !memcmp(magic, "DS4JLENS", 8) &&
+           fread(head, sizeof(head[0]), 4, fp) == 4 && head[0] == 1u &&
+           head[2] == DS4_N_HC * DS4_N_EMBD && head[3] == DS4_N_EMBD && head[1] > 0 && head[1] <= DS4_SCOPE_MAX_LENS;
+}
+
+static int scope_peek_jlens(const char *path) {
+    FILE *fp = scope_open_read(path);
+    uint32_t head[4];
+    const bool ok = fp && scope_read_jlens_head(fp, head);
+    if (fp) fclose(fp);
+    return ok ? (int)head[1] : -1;
+}
+
+static bool scope_load_jlens(ds4_scope *sc, const char *path, char *err, size_t errlen) {
+    FILE *fp = scope_open_read(path);
+    struct stat st;
+    if (!fp || fstat(fileno(fp), &st) != 0) {
+        if (fp) fclose(fp);
+        snprintf(err, errlen, "cannot open J-lens file %s", path);
+        return false;
+    }
+    if (sc->jlens_w && sc->jlens_path && !strcmp(sc->jlens_path, path) &&
+        sc->jlens_mtime == (int64_t)st.st_mtime && sc->jlens_size == (int64_t)st.st_size) {
+        fclose(fp);
+        return true;
+    }
+    uint32_t head[4];
+    bool ok = scope_read_jlens_head(fp, head);
+    const uint64_t per = (uint64_t)DS4_N_EMBD * DS4_N_HC * DS4_N_EMBD;     /* f16 entries per layer */
+    if (ok) {
+        ds4_gpu_tensor_free(sc->jlens_w);
+        free(sc->jlens_path);
+        sc->jlens_path = NULL;
+        sc->n_jlens = 0;
+        sc->jlens_w = ds4_gpu_tensor_alloc((uint64_t)head[1] * per * 2u);
+        ok = sc->jlens_w != NULL;
+    }
+    uint16_t *buf = ok ? xmalloc((size_t)per * 2u) : NULL;
+    for (uint32_t j = 0; ok && j < head[1]; j++) {
+        uint32_t layer = 0;
+        ok = fread(&layer, sizeof(layer), 1, fp) == 1 && layer < sc->n_layer &&
+             (j == 0 || layer > sc->jlens[j - 1]) &&
+             fread(buf, 2u, (size_t)per, fp) == (size_t)per &&
+             ds4_gpu_tensor_write(sc->jlens_w, (uint64_t)j * per * 2u, buf, per * 2u);
+        if (ok) sc->jlens[j] = layer;
+    }
+    free(buf);
+    fclose(fp);
+    if (!ok) {
+        ds4_gpu_tensor_free(sc->jlens_w);
+        sc->jlens_w = NULL;
+        snprintf(err, errlen, "J-lens file %s: bad header (need version 1, %u x %u), truncated, or upload failed",
+                 path, DS4_N_EMBD, DS4_N_HC * DS4_N_EMBD);
+        return false;
+    }
+    sc->n_jlens = head[1];
+    sc->jlens_path = strdup(path);
+    sc->jlens_mtime = (int64_t)st.st_mtime;
+    sc->jlens_size = (int64_t)st.st_size;
+    return true;
+}
+
+int ds4_session_scope_begin(ds4_session *s, const ds4_scope_cfg *cfg, char *err, size_t errlen) {
+    if (!s || !cfg) {
+        snprintf(err, errlen, "missing session or scope config");
+        return 1;
+    }
+    if (s->scope_on) ds4_session_scope_end(s, "superseded");
+    uint32_t family = 0, n_layer = 0, cap = 0;
+    ds4_scope **slot = s->distributed ? NULL : scope_graph(s, &family, &n_layer, &cap);
+    if (!slot) {
+        snprintf(err, errlen, "metalscope capture needs Qwen3.8 or DeepSeek V4.1 on one Metal host");
+        return 1;
+    }
+    const uint32_t topk = cfg->topk > 0 ? (uint32_t)cfg->topk : 10u;
+    if (topk > DS4_SCOPE_MAX_TOPK || cfg->n_lens < 0 || (uint32_t)cfg->n_lens > DS4_SCOPE_MAX_LENS) {
+        snprintf(err, errlen, "scope: topk must be 1..%u and at most %u lens layers",
+                 DS4_SCOPE_MAX_TOPK, DS4_SCOPE_MAX_LENS);
+        return 1;
+    }
+    for (int i = 0; i < cfg->n_lens; i++) {
+        if (cfg->lens_layers[i] < 0 || (uint32_t)cfg->lens_layers[i] >= n_layer ||
+            (i > 0 && cfg->lens_layers[i] <= cfg->lens_layers[i - 1])) {
+            snprintf(err, errlen, "scope: lens layers must be increasing and below %u", n_layer);
+            return 1;
+        }
+    }
+    bool ids_ok = cfg->n_logit_ids >= 0 && (uint32_t)cfg->n_logit_ids <= DS4_SCOPE_MAX_IDS;
+    for (int i = 0; ids_ok && i < cfg->n_logit_ids; i++)
+        ids_ok = cfg->logit_ids[i] >= 0 && (uint32_t)cfg->logit_ids[i] < DS4_N_VOCAB;
+    if (!ids_ok || cfg->rsum_sink < 0) {
+        snprintf(err, errlen, "scope: at most %u logit_ids below %u, and a residual-sum sink of 0 or more",
+                 DS4_SCOPE_MAX_IDS, DS4_N_VOCAB);
+        return 1;
+    }
+    const bool tracing = cfg->trace_path && cfg->trace_path[0];
+    int nj = 0;
+    if (tracing && cfg->jlens_path && cfg->jlens_path[0]) {
+        if (family != DS4_SCOPE_FAMILY_QWEN4) {
+            snprintf(err, errlen, "scope: the J-lens is read on Qwen3.8 only");
+            return 1;
+        }
+        nj = scope_peek_jlens(cfg->jlens_path);
+        if (nj < 0) {
+            snprintf(err, errlen, "scope: %s is not a DS4JLENS file for this model (%u x %u)", cfg->jlens_path,
+                     DS4_N_EMBD, DS4_N_HC * DS4_N_EMBD);
+            return 1;
+        }
+    }
+    const uint32_t n_rows = (uint32_t)cfg->n_lens + (uint32_t)nj;
+    ds4_scope *sc = s->scope;
+    if (sc && (sc->family != family || sc->n_layer != n_layer || sc->cap < cap || n_rows > sc->n_lens_cap)) {
+        scope_destroy(sc);
+        sc = s->scope = NULL;
+    }
+    if (!sc) {
+        sc = s->scope = xcalloc(1, sizeof(*sc));
+        sc->n_lens = (uint32_t)cfg->n_lens;
+        if (!scope_alloc(sc, family, n_layer, cap, n_rows)) {
+            scope_destroy(sc);
+            s->scope = NULL;
+            snprintf(err, errlen, "scope: staging allocation failed");
+            return 1;
+        }
+    }
+    sc->fp = NULL;
+    sc->topk = topk;
+    sc->n_lens = (uint32_t)cfg->n_lens;
+    for (int i = 0; i < cfg->n_lens; i++) sc->lens[i] = (uint32_t)cfg->lens_layers[i];
+    sc->prompt_written = sc->decoding = sc->failed = sc->write_failed = sc->frozen = sc->inserting = false;
+    sc->stopped[0] = '\0';
+    sc->prompt_len = 0;
+    sc->staged_head = sc->staged_output = sc->pending = false;
+    sc->steer_any = false;
+    sc->steer_decode_only = cfg->steer_decode_only;
+    sc->out.len = 0;
+    sc->jlens_on = false;
+    sc->n_ids = tracing ? (uint32_t)cfg->n_logit_ids : 0u;
+    for (uint32_t i = 0; i < sc->n_ids; i++) sc->ids[i] = cfg->logit_ids[i];
+    sc->nx_from = tracing && cfg->next_lp > 0 ? (uint32_t)cfg->next_lp : 0u;
+    sc->lookup_off = cfg->lookup_off;
+    sc->rsum_on = false;
+    if (tracing && cfg->rsum) {
+        /* residual sums: zero sums, last rows NaN until computed (as rows a forward skips read back empty) */
+        const uint64_t floats = (uint64_t)n_layer * DS4_N_HC * DS4_N_EMBD;
+        if (!sc->rsum) sc->rsum = ds4_gpu_tensor_alloc(floats * sizeof(float));
+        if (!sc->rsum_last) sc->rsum_last = ds4_gpu_tensor_alloc(floats * sizeof(float));
+        uint8_t *sum = sc->rsum ? ds4_gpu_tensor_contents(sc->rsum) : NULL;
+        uint8_t *last = sc->rsum_last ? ds4_gpu_tensor_contents(sc->rsum_last) : NULL;
+        if (!sum || !last) {
+            snprintf(err, errlen, "scope: residual-sum allocation failed");
+            return 1;
+        }
+        memset(sum, 0, (size_t)floats * sizeof(float));
+        memset(last, 0xff, (size_t)floats * sizeof(float));
+        memset(sc->rsum_n, 0, sizeof(sc->rsum_n));
+        memset(sc->rsum_next, 0, sizeof(sc->rsum_next));
+        sc->rsum_sink = (uint32_t)cfg->rsum_sink;
+        sc->rsum_on = true;
+    }
+    if (cfg->steer_path && cfg->steer_path[0] && !scope_load_steering(sc, cfg->steer_path, err, errlen)) return 1;
+    if (tracing && nj == 0 && sc->jlens_w) {
+        /* a traced request without the J-lens (/jlens off): give its ~0.8 GB back */
+        ds4_gpu_tensor_free(sc->jlens_w);
+        sc->jlens_w = NULL;
+        free(sc->jlens_path);
+        sc->jlens_path = NULL;
+        sc->n_jlens = 0;
+    }
+    if (nj > 0) {
+        if (!scope_load_jlens(sc, cfg->jlens_path, err, errlen)) {
+            sc->steer_any = false;
+            return 1;
+        }
+        sc->jlens_on = true;
+    }
+    if (tracing) {
+        sc->fp = ds4_scope_trace_create(cfg->trace_path);
+        if (!sc->fp) {
+            snprintf(err, errlen, "scope: cannot create %s (%s)", cfg->trace_path, strerror(errno));
+            sc->steer_any = false;
+            return 1;
+        }
+        scope_write_header(sc);
+    }
+    /* The rows the session holds stand for this request, as for one without a
+     * scope, when they were computed under the same steering (none, or the
+     * same vectors on every row): the request then feeds and records only what
+     * follows them.  Tracing alone changes no activation.  They are dropped,
+     * and every prompt row fed, for other steering (steered to unsteered
+     * included), for positions=decode steering (it steers by position in the
+     * request's own prompt, so rows an earlier request held were steered
+     * otherwise), and when the request needs every prompt row (fresh: a
+     * measurement; the residual sums; the lookup left out, which also drops
+     * them at the end). */
+    uint64_t steer = 0u;
+    if (sc->steer_any) {
+        steer = sc->steer_sig ^ (sc->steer_decode_only ? 0x9e3779b97f4a7c15ull : 0u);
+        if (!steer) steer = 1u;
+    }
+    if (cfg->fresh || sc->rsum_on || sc->lookup_off || (sc->steer_any && sc->steer_decode_only) ||
+        s->scope_kv_steer != steer)
+        ds4_session_invalidate(s);
+    s->scope_kv_steer = steer;
+    *slot = sc;
+    s->scope_on = true;
+    return 0;
+}
+
+void ds4_session_scope_output(ds4_session *s, int token) {
+    if (s && s->scope_on) token_vec_push(&s->scope->out, token);
+}
+
+/* The prompt the request feeds: its own as it begins, then (the server, once it
+ * knows which live state it reuses) the token sequence it syncs.  When the
+ * session already holds exactly that prompt nothing would be fed: ds4 would
+ * sample the first reply token from the logits it kept, but the record needs
+ * the pass fed the prompt's last token (the reply's first lens and top 10), so
+ * the prompt is read again whole. */
+void ds4_session_scope_prompt(ds4_session *s, const ds4_tokens *prompt) {
+    if (!s || !s->scope_on || !prompt || prompt->len <= 0 || s->scope->decoding) return;
+    if (s->checkpoint_valid && s->checkpoint.len == prompt->len && ds4_session_common_prefix(s, prompt) == prompt->len)
+        ds4_session_invalidate(s);
+    scope_set_prompt(s->scope, prompt);
+}
+
+/* A request without a scope: a session whose rows were steered is emptied
+ * first (true then), so they are never reused unsteered. */
+bool ds4_session_scope_none(ds4_session *s) {
+    if (!s || s->scope_on || !s->scope_kv_steer) return false;
+    ds4_session_invalidate(s);
+    s->scope_kv_steer = 0u;
+    return true;
+}
+
+/* Kept out of ds4-server's disk KV cache: a scoped request's session while it
+ * runs, and a session whose rows were steered. */
+bool ds4_session_scope_private(ds4_session *s) {
+    return s && (s->scope_on || s->scope_kv_steer != 0u);
+}
+
+/* The session drops everything from pos on (a speculative block the server
+ * discards, a resample): the rows the trace holds there are superseded by
+ * whatever is fed next (RWND, see the format in ds4_scope.inc). */
+static void scope_note_rewind(ds4_session *s, int pos) {
+    if (!s || !s->scope_on || !scope_tracing(s->scope) || pos < 0) return;
+    ds4_scope *sc = s->scope;
+    scope_flush_pending(sc, NULL, 0);
+    scope_record(sc, "RWND", 4u);
+    scope_put_u32(sc, (uint32_t)pos);
+    scope_flush(sc);
+}
+
+bool ds4_session_scope_active(ds4_session *s) {
+    return s && s->scope_on;
+}
+
+/* Qwen3.8's MTP verify keeps the accepted rows of its record; V4.1's DSpark
+ * is not hooked, so a scoped V4.1 request decodes without speculation. */
+bool ds4_session_scope_allows_speculation(ds4_session *s) {
+    return !s || !s->scope_on || (s->scope && s->scope->family == DS4_SCOPE_FAMILY_QWEN4);
+}
+
+void ds4_session_scope_end(ds4_session *s, const char *finish) {
+    if (!s || !s->scope_on) return;
+    ds4_scope *sc = s->scope;
+    scope_flush_pending(sc, NULL, 0);
+    if (sc->fp && sc->rsum_on && !sc->failed) scope_write_rsum(sc);
+    if (sc->fp) {
+        /* A trace that stopped partway says why after the finish (the reader saves it as partial); after a failed
+         * write nothing is written, so the reader finds no end record. */
+        char fin[256];
+        snprintf(fin, sizeof(fin), sc->failed ? "%s; trace stopped: %s" : "%s", finish ? finish : "", sc->stopped);
+        const uint32_t n = (uint32_t)sc->out.len, len = (uint32_t)strlen(fin);
+        scope_record(sc, "END_", 8u + 4u * n + len);
+        scope_put_u32(sc, n);
+        scope_put(sc, sc->out.v, (size_t)n * sizeof(int32_t));
+        scope_put_u32(sc, len);
+        scope_put(sc, fin, len);
+        scope_flush(sc);
+        if (fclose(sc->fp) != 0) scope_write_fail(sc);
+        sc->fp = NULL;
+    }
+    uint32_t family, n_layer, cap;
+    ds4_scope **slot = scope_graph(s, &family, &n_layer, &cap);
+    if (slot) *slot = NULL;
+    s->scope_on = false;
+    /* steered by position in this prompt, or computed without the lookup: never reused */
+    if ((sc->steer_any && sc->steer_decode_only) || sc->lookup_off) {
+        ds4_session_invalidate(s);
+        s->scope_kv_steer = 0u;
+    }
+    sc->lookup_off = false;
+    sc->nx_from = sc->nx_len = 0;
+    free(sc->nx_prompt);
+    sc->nx_prompt = NULL;
+    ds4_gpu_tensor_free(sc->nx_logits);     /* ~0.25 GB of head tiles: given back */
+    ds4_gpu_tensor_free(sc->nx_stats);
+    sc->nx_logits = sc->nx_stats = NULL;
+    /* a prefill chunk's streams (up to hundreds of MB): given back, the next traced forward sizes its own */
+    ds4_gpu_tensor_free(sc->before);
+    sc->before = NULL;
+    sc->before_rows = 0;
+    sc->steer_any = false;
+    sc->jlens_on = false;           /* the J-lens stays loaded for the next request that names the same file */
+    sc->rsum_on = false;
+    sc->n_ids = 0;
+}
+
+/* Hooks for the session paths: the prompt record before the first prefill,
+ * and the switch to decode for positions=decode steering. */
+static void scope_session_sync(ds4_session *s, const ds4_tokens *prompt) {
+    if (!s || !s->scope_on || !prompt) return;
+    ds4_scope *sc = s->scope;
+    if (!sc->decoding) {
+        scope_write_prompt(sc, prompt);
+        return;
+    }
+    /* Once decoding, a sync that drops positions (a rebuild after a rewind)
+     * replaces the rows there (RWND).  One that appends tokens is either the
+     * server's tool-error suffix (between ds4_session_scope_insert_begin and
+     * _end, which records it) or a re-rendering after the reply is over (the
+     * tool checkpoint's canonical text): the trace ends at the reply. */
+    const int fed = ds4_session_common_prefix(s, prompt);
+    if (s->checkpoint_valid && fed < s->checkpoint.len) scope_note_rewind(s, fed);
+    if (prompt->len > fed && !sc->inserting && scope_tracing(sc)) {
+        scope_flush_pending(sc, NULL, 0);
+        sc->frozen = true;
+    }
+}
+
+void ds4_session_scope_insert_begin(ds4_session *s) {
+    if (s && s->scope_on) s->scope->inserting = true;
+}
+
+/* The server's suffix sync is over: when it fed ``target`` (ok), the text from ``before`` on is part of the reply
+ * the model did not sample.  The reply the record ends with is the one fed: a sampled token the suffix replaces (the
+ * stop token, never fed) is dropped and the suffix's tokens join it (SUFX marks them). */
+void ds4_session_scope_insert_end(ds4_session *s, const ds4_tokens *target, int before) {
+    if (!s || !s->scope_on) return;
+    ds4_scope *sc = s->scope;
+    sc->inserting = false;
+    if (!target || !sc->prompt_len || before < (int)sc->prompt_len || target->len <= before) return;
+    const int keep = before - (int)sc->prompt_len;
+    if (sc->out.len > keep) sc->out.len = keep;
+    for (int i = before; i < target->len; i++) token_vec_push(&sc->out, target->v[i]);
+    if (!scope_tracing(sc)) return;
+    const uint32_t n = (uint32_t)(target->len - before);
+    scope_record(sc, "SUFX", 8u);
+    scope_put_u32(sc, (uint32_t)before);
+    scope_put_u32(sc, n);
+    scope_flush(sc);
+}
+
+static void scope_session_decode(ds4_session *s) {
+    if (s && s->scope_on) s->scope->decoding = true;
+}
+
+static void scope_session_free(ds4_session *s) {
+    ds4_session_scope_end(s, "session closed");
+    if (s->scope) {
+        scope_destroy(s->scope);
+        s->scope = NULL;
+    }
+}
+#else
+/* No GPU: nothing is captured or steered. */
+int ds4_session_scope_begin(ds4_session *s, const ds4_scope_cfg *cfg, char *err, size_t errlen) {
+    (void)s; (void)cfg;
+    snprintf(err, errlen, "metalscope capture needs Qwen3.8 or DeepSeek V4.1 on one Metal host");
+    return 1;
+}
+void ds4_session_scope_output(ds4_session *s, int token) { (void)s; (void)token; }
+void ds4_session_scope_prompt(ds4_session *s, const ds4_tokens *prompt) { (void)s; (void)prompt; }
+bool ds4_session_scope_none(ds4_session *s) { (void)s; return false; }
+bool ds4_session_scope_private(ds4_session *s) { (void)s; return false; }
+void ds4_session_scope_end(ds4_session *s, const char *finish) { (void)s; (void)finish; }
+bool ds4_session_scope_active(ds4_session *s) { (void)s; return false; }
+bool ds4_session_scope_allows_speculation(ds4_session *s) { (void)s; return true; }
+void ds4_session_scope_insert_begin(ds4_session *s) { (void)s; }
+void ds4_session_scope_insert_end(ds4_session *s, const ds4_tokens *target, int before) {
+    (void)s; (void)target; (void)before;
+}
+static void scope_session_sync(ds4_session *s, const ds4_tokens *prompt) { (void)s; (void)prompt; }
+static void scope_note_rewind(ds4_session *s, int pos) { (void)s; (void)pos; }
+static void scope_session_decode(ds4_session *s) { (void)s; }
+static void scope_session_free(ds4_session *s) { (void)s; }
+#endif /* DS4_NO_GPU */
