#!/bin/sh
# Run Python inside oMLX.app's bundled interpreter with metalscope importable.
set -eu
REPO="$(cd "$(dirname "$0")/.." && pwd)"
RES="${OMLX_APP:-/Applications/oMLX.app}/Contents/Resources"
export PYTHONHOME="$RES/Python/cpython-3.11"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$RES:$RES/Python/framework-mlx-base/lib/python3.11/site-packages:$REPO/src:$REPO${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHONHOME/bin/python3" "$@"
